#!/usr/bin/env python3
import curses
import json
import locale
import os
import subprocess
import threading
from dataclasses import dataclass

CARD = "alsa_card.pci-0000_00_1f.3"
PROFILE = "output:analog-surround-40"
HIDDEN_PREFIXES = ("alsa_output.pci-0000_00_1f.3.", "alsa_output.platform-snd_aloop.")
PINNED_ORDER = ("front_jack", "rear_jack")
TEST_SOUND = "/usr/share/sounds/alsa/Front_Center.wav"
STEP = 5
BAR_WIDTH = 18
OUTPUTS, APPS = 0, 1

ACCENT, DIM, GOOD, WARN, BAD, ROUTE_A, ROUTE_B, ROUTE_C = range(1, 9)
ROUTE_COLORS = (ROUTE_A, ROUTE_B, ROUTE_C)


@dataclass
class Sink:
    index: int
    name: str
    label: str
    volume: int
    mute: bool
    running: bool


@dataclass
class Stream:
    index: int
    sink: int
    label: str
    volume: int
    mute: bool
    corked: bool


def pactl(*args):
    return subprocess.run(["pactl", *args], capture_output=True, text=True).stdout


def pactl_json(kind):
    try:
        return json.loads(pactl("-f", "json", "list", kind) or "[]")
    except ValueError:
        return []


def average_volume(volume):
    values = [channel["value"] for channel in volume.values()]
    if not values:
        return 0
    return round(sum(values) / len(values) / 65536 * 100)


def short_label(description):
    if "HDMI" in description and description.endswith("]") and "[" in description:
        return description[description.rindex("[") + 1 : -1] + " (HDMI)"
    for suffix in (" Analog Stereo", " Digital Stereo"):
        description = description.removesuffix(suffix)
    return description


def sink_rank(sink):
    pinned = PINNED_ORDER.index(sink.name) if sink.name in PINNED_ORDER else len(PINNED_ORDER)
    return pinned, sink.label.lower()


def load_sinks(show_all):
    sinks = [
        Sink(
            index=raw["index"],
            name=raw["name"],
            label=short_label(raw["description"]),
            volume=average_volume(raw["volume"]),
            mute=raw["mute"],
            running=raw["state"] == "RUNNING",
        )
        for raw in pactl_json("sinks")
        if show_all or not raw["name"].startswith(HIDDEN_PREFIXES)
    ]
    return sorted(sinks, key=sink_rank)


def load_streams():
    streams = []
    for raw in pactl_json("sink-inputs"):
        props = raw["properties"]
        if props.get("node.virtual") == "true":
            continue
        label = props.get("application.name") or props.get("node.name") or props.get("media.name") or "unknown"
        streams.append(
            Stream(
                index=raw["index"],
                sink=raw["sink"],
                label=label,
                volume=average_volume(raw["volume"]),
                mute=raw["mute"],
                corked=raw.get("corked", False),
            )
        )
    return sorted(streams, key=lambda stream: (stream.label.lower(), stream.index))


def active_profile():
    for card in pactl_json("cards"):
        if card["name"] == CARD:
            return card.get("active_profile", "")
    return ""


class App:
    def __init__(self):
        self.pane = APPS
        self.cursor = [0, 0]
        self.show_all = False
        self.message = ""
        self.message_color = DIM
        self.sinks = []
        self.streams = []
        self.default = ""
        self.profile = ""
        self.dirty = threading.Event()
        self.watcher = None
        self.refresh()

    def refresh(self):
        selected = self.selected()
        self.sinks = load_sinks(self.show_all)
        self.streams = load_streams()
        self.default = pactl("get-default-sink").strip()
        self.profile = active_profile()
        self.restore_cursor(selected)

    def rows(self, pane=None):
        return self.sinks if (self.pane if pane is None else pane) == OUTPUTS else self.streams

    def selected(self):
        rows = self.rows()
        if not rows:
            return None
        return rows[min(self.cursor[self.pane], len(rows) - 1)]

    def restore_cursor(self, previous):
        rows = self.rows()
        if previous is not None:
            for position, row in enumerate(rows):
                if row.index == previous.index:
                    self.cursor[self.pane] = position
                    return
        self.cursor[self.pane] = max(0, min(self.cursor[self.pane], len(rows) - 1))

    def say(self, text, color=DIM):
        self.message = text
        self.message_color = color

    def move(self, delta):
        rows = self.rows()
        if rows:
            self.cursor[self.pane] = max(0, min(self.cursor[self.pane] + delta, len(rows) - 1))

    def jump(self, end):
        rows = self.rows()
        self.cursor[self.pane] = len(rows) - 1 if end and rows else 0

    def switch_pane(self):
        self.pane = OUTPUTS if self.pane == APPS else APPS

    def sink_by_index(self, index):
        return next((sink for sink in self.sinks if sink.index == index), None)

    def route(self, target):
        stream = self.selected() if self.pane == APPS else None
        if stream is None or target is None:
            return
        if target.index == stream.sink:
            return
        pactl("move-sink-input", str(stream.index), target.name)
        self.say(f"{stream.label} now plays on {target.label}. It will stay there.", GOOD)
        self.refresh()

    def cycle_route(self, delta):
        stream = self.selected() if self.pane == APPS else None
        if stream is None or not self.sinks:
            return
        positions = [sink.index for sink in self.sinks]
        current = positions.index(stream.sink) if stream.sink in positions else -1
        self.route(self.sinks[(current + delta) % len(self.sinks)])

    def route_to_number(self, number):
        if self.pane == APPS and 0 < number <= len(self.sinks):
            self.route(self.sinks[number - 1])

    def change_volume(self, delta):
        row = self.selected()
        if row is None:
            return
        level = f"{max(0, min(row.volume + delta, max(100, row.volume)))}%"
        if self.pane == OUTPUTS:
            pactl("set-sink-volume", row.name, level)
        else:
            pactl("set-sink-input-volume", str(row.index), level)
        self.refresh()

    def toggle_mute(self):
        row = self.selected()
        if row is None:
            return
        if self.pane == OUTPUTS:
            pactl("set-sink-mute", row.name, "toggle")
        else:
            pactl("set-sink-input-mute", str(row.index), "toggle")
        self.say(f"{row.label} {'unmuted' if row.mute else 'muted'}.")
        self.refresh()

    def make_default(self):
        sink = self.selected() if self.pane == OUTPUTS else None
        if sink is None:
            return
        pactl("set-default-sink", sink.name)
        self.say(f"New apps now start on {sink.label}.", GOOD)
        self.refresh()

    def test_tone(self):
        sink = self.selected() if self.pane == OUTPUTS else None
        if sink is None:
            return
        subprocess.Popen(
            ["paplay", f"--device={sink.name}", TEST_SOUND],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.say(f"Playing a test sound on {sink.label}.")

    def repair(self):
        pactl("set-card-profile", CARD, PROFILE)
        self.say("Built-in audio is back on the 4.0 profile.", GOOD)
        self.refresh()

    def toggle_hidden(self):
        self.show_all = not self.show_all
        self.say("Showing every output." if self.show_all else "Hiding raw and loopback outputs.")
        self.refresh()


def watch(app):
    app.watcher = subprocess.Popen(
        ["pactl", "subscribe"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
    )
    for line in app.watcher.stdout:
        if any(word in line for word in ("sink", "card", "server")):
            app.dirty.set()


def init_colors():
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(ACCENT, curses.COLOR_CYAN, -1)
    curses.init_pair(DIM, 8 if curses.COLORS > 8 else curses.COLOR_WHITE, -1)
    curses.init_pair(GOOD, curses.COLOR_GREEN, -1)
    curses.init_pair(WARN, curses.COLOR_YELLOW, -1)
    curses.init_pair(BAD, curses.COLOR_RED, -1)
    curses.init_pair(ROUTE_A, curses.COLOR_CYAN, -1)
    curses.init_pair(ROUTE_B, curses.COLOR_MAGENTA, -1)
    curses.init_pair(ROUTE_C, curses.COLOR_BLUE, -1)


def put(screen, y, x, text, attr=0):
    height, width = screen.getmaxyx()
    if y < 0 or y >= height or x >= width:
        return x
    text = text[: max(0, width - x - 1)]
    try:
        screen.addstr(y, x, text, attr)
    except curses.error:
        pass
    return x + len(text)


def fit(text, width):
    return text if len(text) <= width else text[: width - 1] + "…"


def draw_box(screen, y, x, height, width, title, focused):
    border = curses.color_pair(ACCENT if focused else DIM)
    put(screen, y, x, "╭" + "─" * (width - 2) + "╮", border)
    for row in range(1, height - 1):
        put(screen, y + row, x, "│", border)
        put(screen, y + row, x + width - 1, "│", border)
    put(screen, y + height - 1, x, "╰" + "─" * (width - 2) + "╯", border)
    put(screen, y, x + 2, f" {title} ", border | (curses.A_BOLD if focused else 0))


def draw_bar(screen, y, x, volume, mute, color):
    filled = round(min(volume, 100) / 100 * BAR_WIDTH)
    tone = curses.color_pair(DIM) if mute else curses.color_pair(color)
    x = put(screen, y, x, "━" * filled, tone)
    x = put(screen, y, x, "─" * (BAR_WIDTH - filled), curses.color_pair(DIM))
    level = "muted" if mute else f"{volume:>3}%"
    return put(screen, y, x + 1, f"{level:>5}", curses.color_pair(WARN) if mute else 0)


def route_color(app, sink_index):
    for position, sink in enumerate(app.sinks):
        if sink.index == sink_index:
            return ROUTE_COLORS[position % len(ROUTE_COLORS)]
    return DIM


def draw_header(screen, app, width):
    put(screen, 0, 2, "jacks", curses.color_pair(ACCENT) | curses.A_BOLD)
    put(screen, 0, 8, "per-app audio routing", curses.color_pair(DIM))
    if app.profile == PROFILE:
        status, color = "● front and rear split", GOOD
    else:
        status, color = "● jacks not split, press p", WARN
    put(screen, 0, max(2, width - len(status) - 3), status, curses.color_pair(color))


def draw_outputs(screen, app, y, width):
    focused = app.pane == OUTPUTS
    height = max(len(app.sinks), 1) + 2
    draw_box(screen, y, 1, height, width - 2, "Outputs", focused)
    label_width = max(12, min(28, width - BAR_WIDTH - 32))
    for row, sink in enumerate(app.sinks):
        line = y + 1 + row
        selected = focused and row == app.cursor[OUTPUTS]
        color = ROUTE_COLORS[row % len(ROUTE_COLORS)]
        put(screen, line, 3, "▌" if selected else " ", curses.color_pair(ACCENT))
        put(screen, line, 5, f"{row + 1}", curses.color_pair(DIM))
        name_attr = curses.color_pair(color) | (curses.A_BOLD if selected else 0)
        put(screen, line, 7, fit(sink.label, label_width).ljust(label_width), name_attr)
        x = 8 + label_width
        tag = "default" if sink.name == app.default else ""
        put(screen, line, x, tag.ljust(8), curses.color_pair(ACCENT))
        x = draw_bar(screen, line, x + 9, sink.volume, sink.mute, color)
        if sink.running:
            put(screen, line, x + 2, "♪", curses.color_pair(GOOD))
    if not app.sinks:
        put(screen, y + 1, 5, "No outputs found.", curses.color_pair(DIM))
    return y + height


def draw_apps(screen, app, y, width, bottom):
    focused = app.pane == APPS
    height = max(3, min(len(app.streams) + 2, bottom - y))
    draw_box(screen, y, 1, height, width - 2, "Apps", focused)
    label_width = max(10, min(20, width // 5))
    route_width = max(14, min(26, width - label_width - BAR_WIDTH - 30))
    visible = height - 2
    offset = max(0, app.cursor[APPS] - visible + 1)
    for row, stream in enumerate(app.streams[offset : offset + visible]):
        position = row + offset
        line = y + 1 + row
        selected = focused and position == app.cursor[APPS]
        put(screen, line, 3, "▌" if selected else " ", curses.color_pair(ACCENT))
        put(screen, line, 5, fit(stream.label, label_width).ljust(label_width), curses.A_BOLD if selected else 0)
        sink = app.sink_by_index(stream.sink)
        target = sink.label if sink else "hidden output"
        color = route_color(app, stream.sink)
        x = 6 + label_width
        if selected:
            put(screen, line, x, "◂ ", curses.color_pair(DIM))
            put(screen, line, x + 2, fit(target, route_width - 4), curses.color_pair(color) | curses.A_BOLD)
            put(screen, line, x + 2 + len(fit(target, route_width - 4)), " ▸", curses.color_pair(DIM))
        else:
            put(screen, line, x + 2, fit(target, route_width - 4), curses.color_pair(color))
        x = draw_bar(screen, line, x + route_width + 1, stream.volume, stream.mute, color)
        state, tone = ("paused", DIM) if stream.corked else ("playing", GOOD)
        put(screen, line, x + 2, state, curses.color_pair(tone))
    if not app.streams:
        put(screen, y + 1, 5, "No apps are playing audio right now.", curses.color_pair(DIM))


def hints(app):
    if app.pane == APPS:
        keys = [("h/l", "route"), ("1-9", "send to output"), ("-/+", "volume"), ("m", "mute")]
    else:
        keys = [("d", "default"), ("t", "test"), ("-/+", "volume"), ("m", "mute")]
    return keys + [("tab", "pane"), ("a", "all outputs"), ("q", "quit")]


def draw_footer(screen, app, height):
    put(screen, height - 2, 2, app.message, curses.color_pair(app.message_color))
    x = 2
    for key, action in hints(app):
        x = put(screen, height - 1, x, key, curses.color_pair(ACCENT) | curses.A_BOLD)
        x = put(screen, height - 1, x + 1, action, curses.color_pair(DIM)) + 3


def draw(screen, app):
    screen.erase()
    height, width = screen.getmaxyx()
    if height < 10 or width < 60:
        put(screen, 0, 0, "Make the terminal at least 60x10.")
        screen.refresh()
        return
    draw_header(screen, app, width)
    after_outputs = draw_outputs(screen, app, 2, width)
    draw_apps(screen, app, after_outputs + 1, width, height - 3)
    draw_footer(screen, app, height)
    screen.refresh()


def handle(app, key):
    actions = {
        ord("j"): lambda: app.move(1),
        curses.KEY_DOWN: lambda: app.move(1),
        ord("k"): lambda: app.move(-1),
        curses.KEY_UP: lambda: app.move(-1),
        ord("g"): lambda: app.jump(False),
        ord("G"): lambda: app.jump(True),
        4: lambda: app.move(5),
        21: lambda: app.move(-5),
        9: app.switch_pane,
        curses.KEY_BTAB: app.switch_pane,
        ord("h"): lambda: app.cycle_route(-1),
        curses.KEY_LEFT: lambda: app.cycle_route(-1),
        ord("l"): lambda: app.cycle_route(1),
        curses.KEY_RIGHT: lambda: app.cycle_route(1),
        ord("-"): lambda: app.change_volume(-STEP),
        ord("_"): lambda: app.change_volume(-STEP),
        ord("+"): lambda: app.change_volume(STEP),
        ord("="): lambda: app.change_volume(STEP),
        ord("m"): app.toggle_mute,
        ord("d"): app.make_default,
        10: app.make_default,
        ord("t"): app.test_tone,
        ord("p"): app.repair,
        ord("a"): app.toggle_hidden,
        ord("r"): app.refresh,
    }
    if ord("1") <= key <= ord("9"):
        app.route_to_number(key - ord("0"))
    elif key in actions:
        actions[key]()


def main(screen):
    curses.curs_set(0)
    init_colors()
    screen.timeout(120)
    app = App()
    threading.Thread(target=watch, args=(app,), daemon=True).start()
    try:
        while True:
            if app.dirty.is_set():
                app.dirty.clear()
                app.refresh()
            draw(screen, app)
            key = screen.getch()
            if key in (ord("q"), 27):
                break
            if key != -1:
                handle(app, key)
    finally:
        if app.watcher:
            app.watcher.terminate()


if __name__ == "__main__":
    os.environ.setdefault("ESCDELAY", "25")
    locale.setlocale(locale.LC_ALL, "")
    curses.wrapper(main)
