#!/usr/bin/env bash
set -euo pipefail

ARCTIS="alsa_output.usb-SteelSeries_SteelSeries_Arctis_7-00.stereo-game"
REAR="rear_jack"
FRONT="front_jack"

usage() {
  echo "Usage: audio-toggle [rear|front|arctis|status]"
  echo "  no argument cycles rear -> front -> arctis"
}

current_target() {
  case "$(pactl get-default-sink)" in
    "$REAR") echo rear ;;
    "$FRONT") echo front ;;
    "$ARCTIS") echo arctis ;;
    *) echo other ;;
  esac
}

move_streams() {
  local managed id sink
  managed=$(pactl list short sinks | awk -v r="$REAR" -v f="$FRONT" -v a="$ARCTIS" '$2==r || $2==f || $2==a {print $1}')
  pactl list short sink-inputs | while read -r id sink _; do
    if grep -qx "$sink" <<<"$managed"; then
      pactl move-sink-input "$id" "$1" 2>/dev/null || true
    fi
  done
}

switch_to() {
  local sink label
  case "$1" in
    rear)
      sink="$REAR"
      label="Rear 3.5mm"
      ;;
    front)
      sink="$FRONT"
      label="Front 3.5mm"
      ;;
    arctis)
      sink="$ARCTIS"
      label="SteelSeries Arctis 7"
      ;;
    *)
      usage
      exit 1
      ;;
  esac

  pactl set-default-sink "$sink"
  pactl set-sink-mute "$sink" 0
  move_streams "$sink"

  notify-send -t 1500 "Audio: $label" 2>/dev/null || true
  echo "Audio: $label"
}

case "${1:-}" in
  "")
    case "$(current_target)" in
      rear) switch_to front ;;
      front) switch_to arctis ;;
      *) switch_to rear ;;
    esac
    ;;
  status) current_target ;;
  -h|--help) usage ;;
  *) switch_to "$1" ;;
esac
