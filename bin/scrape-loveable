#!/usr/bin/env bash
set -euo pipefail

# scrape-loveable — pull every file/folder of a Lovable project to disk.
#
# Uses Lovable's git API:
#   GET /projects/{id}/git/files?ref={ref}          -> file list
#   GET /projects/{id}/git/file?ref={ref}&path={p}  -> raw file bytes
# Auth is a Firebase ID token (see `scrape-loveable token`).

API="${SCRAPE_LOVEABLE_API:-https://api.lovable.dev}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/scrape-loveable"
RUNS_TSV="$DATA_DIR/runs.tsv"
TOKEN_FILE="$DATA_DIR/token"
DEST_ROOT="${SCRAPE_LOVEABLE_DEST:-$HOME/lovable-projects}"
FIREBASE_AUD="${SCRAPE_LOVEABLE_AUD:-gpt-engineer-390607}"
LOGIN_URL="${SCRAPE_LOVEABLE_LOGIN_URL:-https://lovable.dev/projects}"

C_RESET=$'\e[0m'; C_DIM=$'\e[2m'; C_BOLD=$'\e[1m'
C_CYAN=$'\e[36m'; C_GREEN=$'\e[32m'; C_YELLOW=$'\e[33m'; C_RED=$'\e[31m'; C_MAG=$'\e[35m'

info()  { printf '%s\n' "${C_CYAN}$*${C_RESET}"; }
ok()    { printf '%s\n' "${C_GREEN}$*${C_RESET}"; }
warn()  { printf '%s\n' "${C_YELLOW}$*${C_RESET}" >&2; }
err()   { printf '%s\n' "${C_RED}$*${C_RESET}" >&2; }

need() { command -v "$1" >/dev/null 2>&1 || { err "Missing dependency: $1"; exit 1; }; }
need curl; need jq

mkdir -p "$DATA_DIR"
[[ -f "$RUNS_TSV" ]] || printf 'when\tproject\tref\tfiles\tdest\n' > "$RUNS_TSV"

# ---------------------------------------------------------------------------

token_snippet() {
  cat <<'SNIP'
Paste this into the DevTools console of the Lovable project tab (logged in):

  (async () => {
    const rows = await new Promise((res) => {
      const req = indexedDB.open('firebaseLocalStorageDb');
      req.onsuccess = () => {
        const tx = req.result.transaction('firebaseLocalStorage', 'readonly')
          .objectStore('firebaseLocalStorage').getAll();
        tx.onsuccess = () => res(tx.result);
      };
    });
    copy(rows[0].value.stsTokenManager.accessToken);
    console.log('token copied to clipboard');
  })();

Then run:  scrape-loveable token   (and paste it)
The token is short-lived (~1h); re-grab when you get a 401.
SNIP
}

get_token() {
  if [[ -n "${LOVABLE_TOKEN:-}" ]]; then
    printf '%s' "$LOVABLE_TOKEN"; return
  fi
  if [[ -s "$TOKEN_FILE" ]] && token_is_live "$(cat "$TOKEN_FILE")"; then
    cat "$TOKEN_FILE"; return
  fi

  [[ -s "$TOKEN_FILE" ]] && warn "Cached token expired — pulling a fresh one from your browser…" \
                         || warn "No token cached — pulling one from your browser…"
  if generate_token >&2 && [[ -s "$TOKEN_FILE" ]]; then
    cat "$TOKEN_FILE"; return
  fi

  err "No token set. Run: scrape-loveable generate-token"
  exit 1
}

set_token() {
  warn "Paste your Lovable token (input hidden), then Enter:"
  local t; read -rs t; echo
  if [[ -z "$t" ]]; then err "Empty token, aborted."; exit 1; fi
  save_token "$t"
}

save_token() {
  printf '%s' "$1" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  ok "Token saved to $TOKEN_FILE"
}

# --- token auto-discovery -------------------------------------------------
#
# Chromium keeps IndexedDB in LevelDB files under the profile dir, so the
# Firebase ID token is readable straight off disk — no DevTools console needed.
# Tokens are matched by `aud` so a shared Local Storage DB can't hand us some
# other site's JWT.

b64url_decode() {
  local s="${1//-/+}"; s="${s//_//}"
  case $(( ${#s} % 4 )) in
    2) s="$s==" ;;
    3) s="$s=" ;;
  esac
  printf '%s' "$s" | base64 -d 2>/dev/null || true
}

jwt_payload() { b64url_decode "$(cut -d. -f2 <<<"$1")"; }

browser_roots() {
  cat <<EOF
Brave	$HOME/.config/BraveSoftware/Brave-Browser	brave-browser
Chrome	$HOME/.config/google-chrome	google-chrome-stable
Chromium	$HOME/.config/chromium	chromium
Edge	$HOME/.config/microsoft-edge	microsoft-edge-stable
Vivaldi	$HOME/.config/vivaldi	vivaldi
Opera	$HOME/.config/opera	opera
Chrome·flatpak	$HOME/.var/app/com.google.Chrome/config/google-chrome	flatpak run com.google.Chrome
Chromium·flatpak	$HOME/.var/app/org.chromium.Chromium/config/chromium	flatpak run org.chromium.Chromium
Ungoogled·flatpak	$HOME/.var/app/io.github.ungoogled_software.ungoogled_chromium/config/chromium	flatpak run io.github.ungoogled_software.ungoogled_chromium
EOF
}

profile_label() {
  local pref="$1/Preferences" name=''
  [[ -f "$pref" ]] && name="$(jq -r '.profile.name // empty' "$pref" 2>/dev/null || true)"
  printf '%s' "${name:-$(basename "$1")}"
}

# echo: mtime \t browser \t launcher \t profileDir
find_profiles() {
  local browser root launcher
  while IFS=$'\t' read -r browser root launcher; do
    [[ -d "$root" ]] || continue
    while IFS= read -r store; do
      local profile; profile="$(dirname "$(dirname "$store")")"
      printf '%s\t%s\t%s\t%s\n' \
        "$(stat -c %Y "$store" 2>/dev/null || echo 0)" "$browser" "$launcher" "$profile"
    done < <(find "$root" -maxdepth 3 -type d -name 'https_lovable.dev_0.indexeddb.leveldb' 2>/dev/null)
  done < <(browser_roots) | sort -rn
}

# echo the highest-exp token found in a profile, or nothing
token_from_profile() {
  local profile="$1" best='' best_exp=0
  local -a stores=( "$profile/IndexedDB/https_lovable.dev_0.indexeddb.leveldb" "$profile/Local Storage/leveldb" )
  local raw
  raw="$(grep -raoh 'eyJ[A-Za-z0-9_-]\{10,\}\.eyJ[A-Za-z0-9_-]\{20,\}\.[A-Za-z0-9_-]\{20,\}' \
    "${stores[@]}" 2>/dev/null | sort -u || true)"
  [[ -z "$raw" ]] && return 1

  local t payload aud exp
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    payload="$(jwt_payload "$t")"
    aud="$(jq -r '.aud // empty' <<<"$payload" 2>/dev/null || true)"
    [[ "$aud" == "$FIREBASE_AUD" ]] || continue
    exp="$(jq -r '.exp // 0' <<<"$payload" 2>/dev/null || echo 0)"
    if (( exp > best_exp )); then best_exp="$exp"; best="$t"; fi
  done <<<"$raw"

  [[ -z "$best" ]] && return 1
  printf '%s\t%s' "$best_exp" "$best"
}

launch_browser() {
  local launcher="$1" profile="$2" url="$3"
  local -a cmd; read -ra cmd <<<"$launcher"
  command -v "${cmd[0]}" >/dev/null 2>&1 || { warn "Can't launch ${cmd[0]}; open $url yourself."; return 1; }
  info "Opening $url …"
  "${cmd[@]}" --profile-directory="$(basename "$profile")" "$url" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

generate_token() {
  local url="${1:-$LOGIN_URL}" retried="${2:-0}"

  mapfile -t rows < <(find_profiles)
  if [[ "${#rows[@]}" -eq 0 ]]; then
    err "No browser profile has visited lovable.dev. Log in first, then re-run."
    return 1
  fi

  local -a labels=() tokens=() metas=()
  local stale_browser='' stale_profile='' stale_launcher='' stale_exp=0
  local now; now="$(date +%s)"

  local mtime browser launcher profile found exp tok
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r mtime browser launcher profile <<<"$row"
    found="$(token_from_profile "$profile" || true)"
    [[ -z "$found" ]] && continue
    IFS=$'\t' read -r exp tok <<<"$found"
    if (( exp > now + 60 )); then
      labels+=( "$(printf '%-16s %-22s expires %s' \
        "$browser" "$(profile_label "$profile")" "$(date -d "@$exp" '+%H:%M:%S')")" )
      tokens+=( "$tok" )
      metas+=( "$browser / $(profile_label "$profile")" )
    elif (( exp > stale_exp )); then
      stale_exp="$exp"; stale_browser="$browser"
      stale_profile="$profile"; stale_launcher="$launcher"
    fi
  done

  if [[ "${#tokens[@]}" -eq 0 ]]; then
    if (( retried )); then
      err "Still no live token. Make sure you're actually logged in on lovable.dev."
      return 1
    fi
    if (( stale_exp > 0 )); then
      warn "Found only an expired token ($stale_browser, expired $(date -d "@$stale_exp" '+%F %H:%M'))."
    else
      warn "No Lovable token on disk yet."
    fi
    launch_browser "${stale_launcher:-$(cut -f3 <<<"${rows[0]}")}" \
                   "${stale_profile:-$(cut -f4 <<<"${rows[0]}")}" "$url" || true
    warn "Log in / reload the tab, then press Enter here to retry…"
    read -r _
    generate_token "$url" 1
    return $?
  fi

  local idx=0
  if [[ "${#tokens[@]}" -gt 1 ]] && command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    local pick
    pick="$(for i in "${!labels[@]}"; do printf '%s\t%s\n' "$i" "${labels[$i]}"; done |
      fzf --with-nth=2.. --delimiter='\t' \
          --prompt='token › ' --height=40% --reverse \
          --header='multiple live tokens — most recently used browser first')" || return 1
    idx="$(cut -f1 <<<"$pick")"
  fi

  ok "Grabbed token from ${metas[$idx]}"
  save_token "${tokens[$idx]}"
}

token_is_live() {
  local t="$1" exp
  exp="$(jq -r '.exp // 0' <<<"$(jwt_payload "$t")" 2>/dev/null || echo 0)"
  (( exp > $(date +%s) + 60 ))
}

# Accept a bare id or a full lovable.dev URL, echo the project id.
normalize_id() {
  local raw="$1"
  if [[ "$raw" =~ projects/([0-9a-f-]{36}) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "$raw"
  fi
}

record_run() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$1" "$2" "$3" "$4" >> "$RUNS_TSV"
}

# ---------------------------------------------------------------------------

do_scrape() {
  local project ref dest token
  project="$(normalize_id "$1")"
  ref="${2:-main}"
  dest="${3:-$DEST_ROOT/$project}"
  token="$(get_token)"

  info "Project ${C_BOLD}$project${C_RESET}${C_CYAN} @ $ref"
  info "Dest    $dest"

  local listfile; listfile="$(mktemp)"
  local code
  code="$(curl -sS -w '%{http_code}' -o "$listfile" \
    -H "authorization: Bearer $token" \
    "$API/projects/$project/git/files?ref=$ref")"

  if [[ "$code" == "401" ]]; then
    err "401 unauthorized — token expired or invalid. Run: scrape-loveable token"
    rm -f "$listfile"; exit 1
  fi
  if [[ "$code" != "200" ]]; then
    err "Failed to list files (HTTP $code):"; cat "$listfile" >&2; rm -f "$listfile"; exit 1
  fi

  mapfile -t paths < <(jq -r '.files[].path' "$listfile")
  rm -f "$listfile"
  local total="${#paths[@]}"
  if [[ "$total" -eq 0 ]]; then warn "No files returned."; exit 0; fi
  info "Found $total files. Downloading…"

  local n=0 fail=0
  for p in "${paths[@]}"; do
    local out="$dest/$p"
    mkdir -p "$(dirname "$out")"
    local u="$API/projects/$project/git/file?ref=$ref&path=$(jq -rn --arg s "$p" '$s|@uri')"
    if curl -sS -f -H "authorization: Bearer $token" -o "$out" "$u"; then
      n=$((n+1))
    else
      fail=$((fail+1)); warn "  ! failed: $p"
    fi
    printf '\r  %s%d/%d%s  %s' "$C_DIM" "$((n+fail))" "$total" "$C_RESET" "${p:0:50}"
  done
  printf '\r%*s\r' 80 ''

  record_run "$project" "$ref" "$n" "$dest"
  if [[ "$fail" -gt 0 ]]; then
    warn "Done with $fail failure(s). $n/$total files written to:"
  else
    ok "Done. $n files written to:"
  fi
  printf '%s\n' "$dest"
}

# ---------------------------------------------------------------------------

list_runs() {
  if [[ "$(wc -l < "$RUNS_TSV")" -le 1 ]]; then
    warn "No previous runs yet."; return
  fi
  printf '%s\n' "${C_BOLD}Previous runs${C_RESET}"
  column -t -s $'\t' "$RUNS_TSV" | sed "1s/.*/${C_DIM}&${C_RESET}/"
}

pick_rerun() {
  if [[ "$(wc -l < "$RUNS_TSV")" -le 1 ]]; then
    warn "No previous runs to re-run."; return 1
  fi
  local line
  line="$(tail -n +2 "$RUNS_TSV" | tac | \
    fzf --with-nth=1,2,3,4 --delimiter='\t' \
        --prompt='re-run › ' --height=40% --reverse \
        --header='select a previous run to scrape again')" || return 1
  local project ref dest
  project="$(cut -f2 <<<"$line")"; ref="$(cut -f3 <<<"$line")"; dest="$(cut -f5 <<<"$line")"
  do_scrape "$project" "$ref" "$dest"
}

new_scrape_interactive() {
  local project ref dest
  printf '%s' "${C_MAG}Project id or lovable.dev URL: ${C_RESET}"; read -r project
  [[ -z "$project" ]] && { err "Nothing entered."; return 1; }
  project="$(normalize_id "$project")"
  printf '%s' "${C_MAG}Branch/ref [main]: ${C_RESET}"; read -r ref; ref="${ref:-main}"
  printf '%s' "${C_MAG}Dest [$DEST_ROOT/$project]: ${C_RESET}"; read -r dest
  dest="${dest:-$DEST_ROOT/$project}"
  do_scrape "$project" "$ref" "$dest"
}

menu() {
  local choice
  choice="$(printf '%s\n' \
    "new        — scrape a project" \
    "rerun      — repeat a previous run" \
    "list       — show previous runs" \
    "generate   — auto-grab token from your browser" \
    "token      — paste an auth token manually" \
    "help       — usage + how to get a token" \
    | fzf --prompt='scrape-loveable › ' --height=40% --reverse \
          --header='what do you want to do?')" || exit 0
  case "$choice" in
    new*)      new_scrape_interactive ;;
    rerun*)    pick_rerun ;;
    list*)     list_runs ;;
    generate*) generate_token ;;
    token*)    set_token ;;
    help*)     usage ;;
  esac
}

usage() {
  cat <<EOF
${C_BOLD}scrape-loveable${C_RESET} — download every file of a Lovable project to disk.

${C_BOLD}Usage${C_RESET}
  scrape-loveable                       open interactive menu
  scrape-loveable <id|url> [ref] [dest] scrape directly (ref defaults to main)
  scrape-loveable list                  show previous runs
  scrape-loveable rerun                 pick a previous run and repeat it
  scrape-loveable generate-token [url]  auto-grab a token from your browser
  scrape-loveable token                 paste a token in manually
  scrape-loveable help                  this help

${C_BOLD}Auth${C_RESET}
Tokens are short-lived (~1h). Scraping refreshes them automatically, so you
normally never touch this — ${C_BOLD}--generate-token${C_RESET} is only for doing it up front.

${C_BOLD}generate-token${C_RESET} reads the Firebase ID token straight out of your Chromium
profile's on-disk LevelDB (IndexedDB + Local Storage), newest-used browser
first, keeping only JWTs whose aud is $FIREBASE_AUD. Brave, Chrome,
Chromium, Edge, Vivaldi, Opera and their flatpaks are all searched. If several
profiles hold a live token you get an fzf picker; if none do, the browser opens
at the login URL and it retries after you press Enter.

  scrape-loveable generate-token
  scrape-loveable generate-token https://lovable.dev/projects/<id>

${C_DIM}Manual fallback (if the on-disk grab ever breaks):${C_RESET}
$(token_snippet)

${C_BOLD}Paths${C_RESET}
  runs history : $RUNS_TSV
  token cache  : $TOKEN_FILE
  default dest : $DEST_ROOT/<projectId>   (override with \$SCRAPE_LOVEABLE_DEST)
EOF
}

# ---------------------------------------------------------------------------

case "${1:-}" in
  ""|menu)          menu ;;
  -h|--help|help)   usage ;;
  list|runs)        list_runs ;;
  rerun)            pick_rerun ;;
  token)            set_token ;;
  generate-token|--generate-token|gen|auto)
                    shift; generate_token "${1:-$LOGIN_URL}" ;;
  *)                do_scrape "$@" ;;
esac
