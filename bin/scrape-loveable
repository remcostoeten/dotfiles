#!/usr/bin/env bash
set -euo pipefail

# scrape-loveable — pull every file/folder of a Lovable project to disk.
#
# Uses Lovable's git API:
#   GET /projects/{id}/git/files?ref={ref}          -> file list
#   GET /projects/{id}/git/file?ref={ref}&path={p}  -> raw file bytes
# Auth is a Firebase ID token (see `scrape-loveable token`).

API="${SCRAPE_LOVEABLE_API:-https://api.lovable.dev}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/scrape-loveable"
RUNS_TSV="$DATA_DIR/runs.tsv"
TOKEN_FILE="$DATA_DIR/token"
TOKEN_SRC_FILE="$DATA_DIR/token.src"
DEST_ROOT="${SCRAPE_LOVEABLE_DEST:-$HOME/lovable-projects}"
FIREBASE_AUD="${SCRAPE_LOVEABLE_AUD:-gpt-engineer-390607}"
LOGIN_URL="${SCRAPE_LOVEABLE_LOGIN_URL:-https://lovable.dev/projects}"
MAIN_ACCOUNT="${SCRAPE_LOVEABLE_MAIN_ACCOUNT:-stoetenremco.rs@gmail.com}"

C_RESET=$'\e[0m'; C_DIM=$'\e[2m'; C_BOLD=$'\e[1m'
C_CYAN=$'\e[36m'; C_GREEN=$'\e[32m'; C_YELLOW=$'\e[33m'; C_RED=$'\e[31m'; C_MAG=$'\e[35m'

info()  { printf '%s\n' "${C_CYAN}$*${C_RESET}"; }
ok()    { printf '%s\n' "${C_GREEN}$*${C_RESET}"; }
warn()  { printf '%s\n' "${C_YELLOW}$*${C_RESET}" >&2; }
err()   { printf '%s\n' "${C_RED}$*${C_RESET}" >&2; }

need() { command -v "$1" >/dev/null 2>&1 || { err "Missing dependency: $1"; exit 1; }; }
need curl; need jq

mkdir -p "$DATA_DIR"
[[ -f "$RUNS_TSV" ]] || printf 'when\tproject\tref\tfiles\tdest\tname\n' > "$RUNS_TSV"
head -1 "$RUNS_TSV" | grep -q $'\tname' || sed -i '1s/$/\tname/' "$RUNS_TSV"

# ---------------------------------------------------------------------------

token_snippet() {
  cat <<'SNIP'
Paste this into the DevTools console of the Lovable project tab (logged in):

  (async () => {
    const rows = await new Promise((res) => {
      const req = indexedDB.open('firebaseLocalStorageDb');
      req.onsuccess = () => {
        const tx = req.result.transaction('firebaseLocalStorage', 'readonly')
          .objectStore('firebaseLocalStorage').getAll();
        tx.onsuccess = () => res(tx.result);
      };
    });
    copy(rows[0].value.stsTokenManager.accessToken);
    console.log('token copied to clipboard');
  })();

Then run:  scrape-loveable token   (and paste it)
The token is short-lived (~1h); re-grab when you get a 401.
SNIP
}

get_token() {
  if [[ -n "${LOVABLE_TOKEN:-}" ]]; then
    printf '%s' "$LOVABLE_TOKEN"; return
  fi
  if [[ -s "$TOKEN_FILE" ]] && token_is_live "$(cat "$TOKEN_FILE")"; then
    cat "$TOKEN_FILE"; return
  fi

  [[ -s "$TOKEN_FILE" ]] && warn "Cached token expired — pulling a fresh one from your browser…" \
                         || warn "No token cached — pulling one from your browser…"
  if generate_token >&2 && [[ -s "$TOKEN_FILE" ]]; then
    cat "$TOKEN_FILE"; return
  fi

  err "No token set. Run: scrape-loveable generate-token"
  exit 1
}

set_token() {
  warn "Paste your Lovable token (input hidden), then Enter:"
  local t; read -rs t; echo
  if [[ -z "$t" ]]; then err "Empty token, aborted."; exit 1; fi
  save_token "$t" "pasted manually"
}

save_token() {
  printf '%s' "$1" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  printf '%s' "${2:-manual}" > "$TOKEN_SRC_FILE"
  local email; email="$(token_email "$1")"
  ok "Token saved — ${email:-unknown account}, $(fmt_expiry "$(token_exp "$1")")"
}

token_source() {
  if [[ -n "${LOVABLE_TOKEN:-}" ]]; then printf '$LOVABLE_TOKEN'
  elif [[ -s "$TOKEN_SRC_FILE" ]]; then cat "$TOKEN_SRC_FILE"
  else printf 'cached token'
  fi
}

# --- token auto-discovery -------------------------------------------------
#
# Chromium keeps IndexedDB in LevelDB files under the profile dir, so the
# Firebase ID token is readable straight off disk — no DevTools console needed.
# Tokens are matched by `aud` so a shared Local Storage DB can't hand us some
# other site's JWT.

b64url_decode() {
  local s="${1//-/+}"; s="${s//_//}"
  case $(( ${#s} % 4 )) in
    2) s="$s==" ;;
    3) s="$s=" ;;
  esac
  printf '%s' "$s" | base64 -d 2>/dev/null || true
}

jwt_payload() { b64url_decode "$(cut -d. -f2 <<<"$1")"; }

token_email() { jq -r '.email // empty' <<<"$(jwt_payload "$1")" 2>/dev/null || true; }
token_exp()   { jq -r '.exp // 0' <<<"$(jwt_payload "$1")" 2>/dev/null || echo 0; }

fmt_dur() {
  local s=$1
  if   (( s >= 86400 )); then printf '%dd'      $(( s / 86400 ))
  elif (( s >= 3600 ));  then printf '%dh%02dm' $(( s / 3600 )) $(( s % 3600 / 60 ))
  elif (( s >= 60 ));    then printf '%dm'      $(( s / 60 ))
  else                        printf '%ds'      "$s"
  fi
}

fmt_expiry() {
  local exp="${1:-0}" now; now="$(date +%s)"
  if (( exp == 0 )); then printf 'expiry unknown'; return; fi
  local d=$(( exp - now ))
  if (( d > 0 )); then
    printf 'expires %s (in %s)' "$(date -d "@$exp" '+%H:%M')" "$(fmt_dur "$d")"
  else
    printf 'expired %s ago' "$(fmt_dur "$(( -d ))")"
  fi
}

browser_roots() {
  cat <<EOF
Brave	$HOME/.config/BraveSoftware/Brave-Browser	brave-browser
Chrome	$HOME/.config/google-chrome	google-chrome-stable
Chromium	$HOME/.config/chromium	chromium
Edge	$HOME/.config/microsoft-edge	microsoft-edge-stable
Vivaldi	$HOME/.config/vivaldi	vivaldi
Opera	$HOME/.config/opera	opera
Chrome·flatpak	$HOME/.var/app/com.google.Chrome/config/google-chrome	flatpak run com.google.Chrome
Chromium·flatpak	$HOME/.var/app/org.chromium.Chromium/config/chromium	flatpak run org.chromium.Chromium
Ungoogled·flatpak	$HOME/.var/app/io.github.ungoogled_software.ungoogled_chromium/config/chromium	flatpak run io.github.ungoogled_software.ungoogled_chromium
EOF
}

profile_label() {
  local pref="$1/Preferences" name=''
  [[ -f "$pref" ]] && name="$(jq -r '.profile.name // empty' "$pref" 2>/dev/null || true)"
  printf '%s' "${name:-$(basename "$1")}"
}

# echo: mtime \t browser \t launcher \t profileDir
find_profiles() {
  local browser root launcher
  while IFS=$'\t' read -r browser root launcher; do
    [[ -d "$root" ]] || continue
    while IFS= read -r store; do
      local profile; profile="$(dirname "$(dirname "$store")")"
      printf '%s\t%s\t%s\t%s\n' \
        "$(stat -c %Y "$store" 2>/dev/null || echo 0)" "$browser" "$launcher" "$profile"
    done < <(find "$root" -maxdepth 3 -type d -name 'https_lovable.dev_0.indexeddb.leveldb' 2>/dev/null)
  done < <(browser_roots) | sort -rn
}

# echo the highest-exp token found in a profile as: exp \t email \t token
token_from_profile() {
  local profile="$1" best='' best_exp=0 best_email=''
  local -a stores=( "$profile/IndexedDB/https_lovable.dev_0.indexeddb.leveldb" "$profile/Local Storage/leveldb" )
  local raw
  raw="$(grep -raoh 'eyJ[A-Za-z0-9_-]\{10,\}\.eyJ[A-Za-z0-9_-]\{20,\}\.[A-Za-z0-9_-]\{20,\}' \
    "${stores[@]}" 2>/dev/null | sort -u || true)"
  [[ -z "$raw" ]] && return 1

  local t payload aud exp
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    payload="$(jwt_payload "$t")"
    aud="$(jq -r '.aud // empty' <<<"$payload" 2>/dev/null || true)"
    [[ "$aud" == "$FIREBASE_AUD" ]] || continue
    exp="$(jq -r '.exp // 0' <<<"$payload" 2>/dev/null || echo 0)"
    if (( exp > best_exp )); then
      best_exp="$exp"; best="$t"
      best_email="$(jq -r '.email // empty' <<<"$payload" 2>/dev/null || true)"
    fi
  done <<<"$raw"

  [[ -z "$best" ]] && return 1
  printf '%s\t%s\t%s' "$best_exp" "${best_email:-?}" "$best"
}

launch_browser() {
  local launcher="$1" profile="$2" url="$3"
  local -a cmd; read -ra cmd <<<"$launcher"
  command -v "${cmd[0]}" >/dev/null 2>&1 || { warn "Can't launch ${cmd[0]}; open $url yourself."; return 1; }
  info "Opening $url …"
  "${cmd[@]}" --profile-directory="$(basename "$profile")" "$url" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

generate_token() {
  local url="${1:-$LOGIN_URL}" retried="${2:-0}"

  mapfile -t rows < <(find_profiles)
  if [[ "${#rows[@]}" -eq 0 ]]; then
    err "No browser profile has visited lovable.dev. Log in first, then re-run."
    return 1
  fi

  local -a labels=() tokens=() metas=()
  local stale_browser='' stale_profile='' stale_launcher='' stale_exp=0
  local now; now="$(date +%s)"

  local mtime browser launcher profile found exp email tok
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r mtime browser launcher profile <<<"$row"
    found="$(token_from_profile "$profile" || true)"
    [[ -z "$found" ]] && continue
    IFS=$'\t' read -r exp email tok <<<"$found"
    if (( exp > now + 60 )); then
      labels+=( "$(printf '%-16s %-14s %-30s %s' \
        "$browser" "$(profile_label "$profile")" "$email" "$(fmt_expiry "$exp")")" )
      tokens+=( "$tok" )
      metas+=( "$browser / $(profile_label "$profile") — $email" )
    elif (( exp > stale_exp )); then
      stale_exp="$exp"; stale_browser="$browser"
      stale_profile="$profile"; stale_launcher="$launcher"
    fi
  done

  if [[ "${#tokens[@]}" -eq 0 ]]; then
    if (( retried )); then
      err "Still no live token. Make sure you're actually logged in on lovable.dev."
      return 1
    fi
    if (( stale_exp > 0 )); then
      warn "Found only an expired token ($stale_browser, expired $(date -d "@$stale_exp" '+%F %H:%M'))."
    else
      warn "No Lovable token on disk yet."
    fi
    launch_browser "${stale_launcher:-$(cut -f3 <<<"${rows[0]}")}" \
                   "${stale_profile:-$(cut -f4 <<<"${rows[0]}")}" "$url" || true
    warn "Log in / reload the tab, then press Enter here to retry…"
    read -r _
    generate_token "$url" 1
    return $?
  fi

  local idx=0
  if [[ "${#tokens[@]}" -gt 1 ]] && command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    local pick
    pick="$(for i in "${!labels[@]}"; do printf '%s\t%s\n' "$i" "${labels[$i]}"; done |
      fzf --with-nth=2.. --delimiter='\t' \
          --prompt='token › ' --height=40% --reverse \
          --header='multiple live sessions — pick the ACCOUNT that owns the project')" || return 1
    idx="$(cut -f1 <<<"$pick")"
  fi

  ok "Grabbed token from ${metas[$idx]}"
  save_token "${tokens[$idx]}" "${metas[$idx]}"
}

token_is_live() {
  local t="$1" exp
  exp="$(jq -r '.exp // 0' <<<"$(jwt_payload "$t")" 2>/dev/null || echo 0)"
  (( exp > $(date +%s) + 60 ))
}

# Accept a bare id or a full lovable.dev URL, echo the project id.
normalize_id() {
  local raw="$1"
  if [[ "$raw" =~ projects/([0-9a-f-]{36}) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "$raw"
  fi
}

record_run() {
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$1" "$2" "$3" "$4" "${5:-}" >> "$RUNS_TSV"
}

fetch_project_name() {
  local project="$1" token="$2"
  curl -sS -m 10 -H "authorization: Bearer $token" \
    "$API/projects/$project/details" 2>/dev/null \
    | jq -r '.name // .display_name // empty' 2>/dev/null || true
}

fmt_when() {
  local ts="$1"
  date -d "$ts" +%s >/dev/null 2>&1 || { printf '%s' "$ts"; return; }
  local day; day="$(date -d "$ts" +%F)"
  if [[ "$day" == "$(date +%F)" ]]; then
    printf 'today %s' "$(date -d "$ts" +%H:%M)"
  elif [[ "$day" == "$(date -d yesterday +%F)" ]]; then
    printf 'yesterday %s' "$(date -d "$ts" +%H:%M)"
  elif [[ "$(date -d "$ts" +%Y)" == "$(date +%Y)" ]]; then
    date -d "$ts" '+%-d %b %H:%M'
  else
    date -d "$ts" '+%-d %b %Y'
  fi
}

run_display_name() {
  local project="$1" dest="$2" stored="${3:-}"
  if [[ -n "$stored" ]]; then printf '%s' "$stored"; return; fi
  local base; base="$(basename "$dest")"
  if [[ ! "$base" =~ ^[0-9a-f-]{36}$ ]]; then printf '%s' "$base"; return; fi
  printf 'id %s' "${project:0:13}"
}

# ---------------------------------------------------------------------------

list_accounts() {
  local now; now="$(date +%s)"
  mapfile -t rows < <(find_profiles)
  if [[ "${#rows[@]}" -eq 0 ]]; then
    warn "No browser profile has visited lovable.dev yet."
    return
  fi

  local mtime browser launcher profile found exp email tok status mark
  local table=''
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r mtime browser launcher profile <<<"$row"
    found="$(token_from_profile "$profile" || true)"
    [[ -z "$found" ]] && continue
    IFS=$'\t' read -r exp email tok <<<"$found"
    if (( exp > now + 60 )); then status="live · $(fmt_expiry "$exp")"; else status="$(fmt_expiry "$exp")"; fi
    mark=''; [[ "$email" == "$MAIN_ACCOUNT" ]] && mark=' ★main'
    table+="$(printf '%s\t%s\t%s%s\t%s' "$browser" "$(profile_label "$profile")" "$email" "$mark" "$status")"$'\n'
  done

  printf '%s\n' "${C_BOLD}Lovable sessions on this machine${C_RESET}"
  if [[ -z "$table" ]]; then
    warn "Profiles found, but none holds a Lovable token. Log in on lovable.dev first."
  else
    printf 'BROWSER\tPROFILE\tACCOUNT\tSESSION\n%s' "$table" \
      | column -t -s $'\t' \
      | sed -e "1s/.*/${C_DIM}&${C_RESET}/" \
            -e "s/\blive\b/${C_GREEN}live${C_RESET}/" \
            -e "s/\bexpired\b/${C_RED}expired${C_RESET}/" \
            -e "s/★main/${C_MAG}★main${C_RESET}/"
  fi

  echo
  if [[ -n "${LOVABLE_TOKEN:-}" ]]; then
    info "Active: \$LOVABLE_TOKEN — ${C_BOLD}$(token_email "$LOVABLE_TOKEN")${C_RESET}${C_CYAN}, $(fmt_expiry "$(token_exp "$LOVABLE_TOKEN")")"
  elif [[ -s "$TOKEN_FILE" ]]; then
    local t; t="$(cat "$TOKEN_FILE")"
    if token_is_live "$t"; then
      info "Active: ${C_BOLD}$(token_email "$t")${C_RESET}${C_CYAN} — $(fmt_expiry "$(token_exp "$t")") ${C_DIM}· via $(token_source)${C_RESET}"
    else
      warn "Active token ($(token_email "$t")) has expired — the next scrape re-grabs one automatically."
    fi
  else
    warn "No token cached yet — the first scrape grabs one automatically."
  fi
}

# ---------------------------------------------------------------------------

draw_progress() {
  local cur=$1 total=$2 label=$3 width=28
  local filled=$(( cur * width / total )) bar='' i
  for (( i = 0; i < width; i++ )); do
    if (( i < filled )); then bar+='█'; else bar+='░'; fi
  done
  printf '\r\033[K  %s%s%s %3d%%  %s%d/%d%s  %s%.48s%s' \
    "$C_GREEN" "$bar" "$C_RESET" $(( cur * 100 / total )) \
    "$C_DIM" "$cur" "$total" "$C_RESET" "$C_DIM" "$label" "$C_RESET"
}

explain_403() {
  local who="$1"
  echo >&2
  err "403 forbidden — this project is not accessible as ${who:-an unknown account}."
  echo >&2
  if [[ -n "$who" && "$who" != "$MAIN_ACCOUNT" ]]; then
    warn "This is the wrong-account trap: a project (or remix) belongs to whichever"
    warn "account was logged in when it was created — for you that's usually"
    warn "${C_BOLD}$MAIN_ACCOUNT${C_RESET}${C_YELLOW}."
    warn ""
    warn "Fix: log in to lovable.dev as $MAIN_ACCOUNT in any Chromium browser,"
    warn "open the project once so it can mint a token, then re-run this scrape."
    warn "If several sessions are live you'll get a picker — choose that account."
  else
    warn "You're already on ${MAIN_ACCOUNT} — the project is private under some other"
    warn "account. Open it in the browser to confirm, or ask the owner to share it."
  fi
  echo >&2
  list_accounts >&2
}

do_scrape() {
  local project ref dest token
  project="$(normalize_id "$1")"
  ref="${2:-main}"
  dest="${3:-$DEST_ROOT/$project}"
  token="$(get_token)"

  local who; who="$(token_email "$token")"
  local pname; pname="$(fetch_project_name "$project" "$token")"

  if [[ -n "$pname" ]]; then
    info "Project ${C_BOLD}$pname${C_RESET}${C_CYAN} @ $ref ${C_DIM}· $project${C_RESET}"
  else
    info "Project ${C_BOLD}$project${C_RESET}${C_CYAN} @ $ref"
  fi
  info "Account ${C_BOLD}${who:-unknown}${C_RESET}${C_CYAN} ${C_DIM}$(fmt_expiry "$(token_exp "$token")") · via $(token_source)${C_RESET}"
  info "Dest    $dest"
  [[ -n "$who" && "$who" != "$MAIN_ACCOUNT" ]] && \
    warn "Note: not the main account ($MAIN_ACCOUNT) — private projects under it will 403."

  printf '%s' "${C_DIM}  Fetching file list…${C_RESET}"
  local listfile; listfile="$(mktemp)"
  local code
  code="$(curl -sS -w '%{http_code}' -o "$listfile" \
    -H "authorization: Bearer $token" \
    "$API/projects/$project/git/files?ref=$ref")"
  printf '\r\033[K'

  if [[ "$code" == "401" ]]; then
    rm -f "$listfile"
    err "401 unauthorized — token expired or invalid."
    warn "Re-grab one with: scrape-loveable generate-token"
    exit 1
  fi
  if [[ "$code" == "403" ]]; then
    rm -f "$listfile"
    explain_403 "$who"
    exit 1
  fi
  if [[ "$code" != "200" ]]; then
    err "Failed to list files (HTTP $code):"; cat "$listfile" >&2; rm -f "$listfile"; exit 1
  fi

  mapfile -t paths < <(jq -r '.files[].path' "$listfile")
  rm -f "$listfile"
  local total="${#paths[@]}"
  if [[ "$total" -eq 0 ]]; then warn "No files returned."; exit 0; fi
  ok "Found $total files."

  local n=0 started; started="$(date +%s)"
  local -a failed=()
  for p in "${paths[@]}"; do
    local out="$dest/$p"
    mkdir -p "$(dirname "$out")"
    local u="$API/projects/$project/git/file?ref=$ref&path=$(jq -rn --arg s "$p" '$s|@uri')"
    if curl -sS -f -H "authorization: Bearer $token" -o "$out" "$u"; then
      n=$((n+1))
    else
      failed+=( "$p" )
    fi
    draw_progress $(( n + ${#failed[@]} )) "$total" "$p"
  done
  printf '\r\033[K'

  local took=$(( $(date +%s) - started ))
  record_run "$project" "$ref" "$n" "$dest" "$pname"
  if [[ "${#failed[@]}" -gt 0 ]]; then
    warn "${#failed[@]} file(s) failed:"
    for p in "${failed[@]}"; do warn "    $p"; done
    warn "$n/$total files in $(fmt_dur "$took") → $dest"
  else
    ok "✓ $n files in $(fmt_dur "$took") → $dest"
  fi
}

# ---------------------------------------------------------------------------

list_runs() {
  if [[ "$(wc -l < "$RUNS_TSV")" -le 1 ]]; then
    warn "No previous runs yet."; return
  fi
  printf '%s\n' "${C_BOLD}Previous runs${C_RESET}"
  {
    printf 'WHEN\tPROJECT\tREF\tFILES\tDEST\n'
    local when project ref files dest name
    while IFS=$'\t' read -r when project ref files dest name; do
      printf '%s\t%s\t%s\t%s\t%s\n' \
        "$(fmt_when "$when")" "$(run_display_name "$project" "$dest" "$name")" \
        "$ref" "$files" "${dest/#$HOME/\~}"
    done < <(tail -n +2 "$RUNS_TSV" | tac)
  } | column -t -s $'\t' | sed "1s/.*/${C_DIM}&${C_RESET}/"
}

pick_rerun() {
  if [[ "$(wc -l < "$RUNS_TSV")" -le 1 ]]; then
    warn "No previous runs to re-run."; return 1
  fi
  mapfile -t raw < <(tail -n +2 "$RUNS_TSV" | tac)
  local -a menu=()
  local i when project ref files dest name
  for i in "${!raw[@]}"; do
    IFS=$'\t' read -r when project ref files dest name <<<"${raw[$i]}"
    menu+=( "$(printf '%s\t%-16s  %-32s %-5s %3s files  %s' "$i" \
      "$(fmt_when "$when")" "$(run_display_name "$project" "$dest" "$name")" \
      "$ref" "$files" "${project:0:8}")" )
  done
  local pick
  pick="$(printf '%s\n' "${menu[@]}" | \
    fzf --with-nth=2.. --delimiter='\t' \
        --prompt='re-run › ' --height=40% --reverse \
        --header='select a previous run to scrape again')" || return 1
  IFS=$'\t' read -r when project ref files dest name <<<"${raw[$(cut -f1 <<<"$pick")]}"
  do_scrape "$project" "$ref" "$dest"
}

new_scrape_interactive() {
  local project ref dest
  printf '%s' "${C_MAG}Project id or lovable.dev URL: ${C_RESET}"; read -r project
  [[ -z "$project" ]] && { err "Nothing entered."; return 1; }
  project="$(normalize_id "$project")"
  printf '%s' "${C_MAG}Branch/ref [main]: ${C_RESET}"; read -r ref; ref="${ref:-main}"
  printf '%s' "${C_MAG}Dest [$DEST_ROOT/$project]: ${C_RESET}"; read -r dest
  dest="${dest:-$DEST_ROOT/$project}"
  do_scrape "$project" "$ref" "$dest"
}

menu() {
  local choice
  choice="$(printf '%s\n' \
    "new        — scrape a project" \
    "rerun      — repeat a previous run" \
    "list       — show previous runs" \
    "accounts   — show browser sessions + active token" \
    "generate   — auto-grab token from your browser" \
    "token      — paste an auth token manually" \
    "help       — usage + how to get a token" \
    | fzf --prompt='scrape-loveable › ' --height=40% --reverse \
          --header='what do you want to do?')" || exit 0
  case "$choice" in
    new*)      new_scrape_interactive ;;
    rerun*)    pick_rerun ;;
    list*)     list_runs ;;
    accounts*) list_accounts ;;
    generate*) generate_token ;;
    token*)    set_token ;;
    help*)     usage ;;
  esac
}

usage() {
  cat <<EOF
${C_BOLD}scrape-loveable${C_RESET} — download every file of a Lovable project to disk.

${C_BOLD}Usage${C_RESET}
  scrape-loveable                       open interactive menu
  scrape-loveable <id|url> [ref] [dest] scrape directly (ref defaults to main)
  scrape-loveable accounts              show browser sessions + active token
  scrape-loveable list                  show previous runs
  scrape-loveable rerun                 pick a previous run and repeat it
  scrape-loveable generate-token [url]  auto-grab a token from your browser
  scrape-loveable token                 paste a token in manually
  scrape-loveable help                  this help

${C_BOLD}Auth${C_RESET}
Tokens are short-lived (~1h). Scraping refreshes them automatically, so you
normally never touch this — ${C_BOLD}--generate-token${C_RESET} is only for doing it up front.

Projects are account-bound: a 403 almost always means the token belongs to a
different Lovable account than the one that owns the project. Your main
account is ${C_BOLD}$MAIN_ACCOUNT${C_RESET} (override with \$SCRAPE_LOVEABLE_MAIN_ACCOUNT).
Check who you are with:  scrape-loveable accounts

${C_BOLD}generate-token${C_RESET} reads the Firebase ID token straight out of your Chromium
profile's on-disk LevelDB (IndexedDB + Local Storage), newest-used browser
first, keeping only JWTs whose aud is $FIREBASE_AUD. Brave, Chrome,
Chromium, Edge, Vivaldi, Opera and their flatpaks are all searched. If several
profiles hold a live token you get an fzf picker (labelled per account); if
none do, the browser opens at the login URL and it retries after you press
Enter.

  scrape-loveable generate-token
  scrape-loveable generate-token https://lovable.dev/projects/<id>

${C_DIM}Manual fallback (if the on-disk grab ever breaks):${C_RESET}
$(token_snippet)

${C_BOLD}Paths${C_RESET}
  runs history : $RUNS_TSV
  token cache  : $TOKEN_FILE
  default dest : $DEST_ROOT/<projectId>   (override with \$SCRAPE_LOVEABLE_DEST)
EOF
}

# ---------------------------------------------------------------------------

case "${1:-}" in
  ""|menu)          menu ;;
  -h|--help|help)   usage ;;
  list|runs)        list_runs ;;
  rerun)            pick_rerun ;;
  accounts|whoami|sessions)
                    list_accounts ;;
  token)            set_token ;;
  generate-token|--generate-token|gen|auto)
                    shift; generate_token "${1:-$LOGIN_URL}" ;;
  *)                do_scrape "$@" ;;
esac
