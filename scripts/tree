DEFAULT_IGNORES = [
    ".git",
    "node_modules",
    ".next",
    ".nuxt",
    "dist",
    "build",
    "out",
    "coverage",
    "target",
    "vendor",
    "__pycache__",
    ".pytest_cache",
    ".cache",
    ".parcel-cache",
    ".turbo",
    ".vercel",
    ".netlify",
    ".DS_Store",
    "*.pyc",
    "*.log",
]
BUILTIN_PRESETS = {
    "default": {},
    "code": {"depth": 4, "git-ignore": True, "default-ignore": True, "dirs-first": True},
    "clean": {"depth": 3, "default-ignore": True, "plain": True},
    "full": {"depth": None, "all": True, "default-ignore": False},
    "raw": {"depth": None, "all": True, "default-ignore": False, "plain": True, "sort": "none"},
    "docs": {"depth": 4, "include": ["*.md", "*.mdx", "*.txt", "*.rst"]},
}


@dataclass(frozen=True)
class Argument:
    name: str
    long: str
    short: str
    description: str
    value: str | None = None
    values: tuple[str, ...] = ()
    repeatable: bool = False


