#!/usr/bin/env bash
# DOCSTRING: Android Emulator Management Tool
# Comprehensive helper for managing Android emulator and apps

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Pastel colors matching cfg/docker scripts
PASTEL_PINK='\033[38;2;250;162;193m'
PASTEL_MAGENTA='\033[38;2;212;187;248m'
PASTEL_PURPLE='\033[38;2;165;216;255m'
PASTEL_BLUE='\033[38;2;178;242;187m'
PASTEL_CYAN='\033[38;2;255;236;153m'
PASTEL_GREEN='\033[38;2;255;216;168m'
PASTEL_ORANGE='\033[38;2;255;135;135m'
PASTEL_RED='\033[38;2;137;220;235m'

android_sdk="$HOME/Android/Sdk"
adb_path="$android_sdk/platform-tools/adb"
emulator_path="$android_sdk/emulator/emulator"
studio_path="$HOME/Android/android-studio/bin/studio.sh"

# XDG-aware AVD location: avdmanager/emulator put AVDs under
# $XDG_CONFIG_HOME/.android/avd when XDG_CONFIG_HOME is set, instead of ~/.android/avd
if [ -d "$HOME/.config/.android/avd" ]; then
    export ANDROID_AVD_HOME="$HOME/.config/.android/avd"
fi

# Preferred devices in order of preference
preferred_devices=(
    "Pixel_6_API_35_Dev"
    "Pixel_6_API_35"
    "Pixel_9_Pro_Fold"
    "Pixel_9_Pro"
    "Pixel_9_Pro_Test"
    "Pixel_9_Pro_Test_API_35"
    "Pixel_9"
    "Pixel_8_Pro"
)

# Enhanced logging functions. Written to stderr so functions that return a
# value via `echo` inside a $(...) capture (e.g. find_best_device) don't get
# their return value corrupted by log output on stdout.
log_info() {
    echo -e "${CYAN}ℹ️  $1${NC}" >&2
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}" >&2
}

log_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}" >&2
}

log_error() {
    echo -e "${RED}❌ $1${NC}" >&2
}

log_debug() {
    if [ "${DEBUG:-0}" = "1" ]; then
        echo -e "${MAGENTA}🐛 DEBUG: $1${NC}"
    fi
}

get_version() {
    local version_file="$(dirname "$0")/../VERSION"
    if [ -f "$version_file" ]; then
        cat "$version_file" | tr -d '\n'
    else
        echo "unknown"
    fi
}

remove_ansi() {
    echo -e "$1" | sed 's/\x1b\[[0-9;]*m//g'
}

create_gradient_text() {
    local text="$1"
    local colors=("$PASTEL_PINK" "$PASTEL_MAGENTA" "$PASTEL_PURPLE" "$PASTEL_BLUE" "$PASTEL_CYAN" "$PASTEL_GREEN")
    local result=""
    local text_len=${#text}

    if [ $text_len -eq 0 ]; then
        echo "$text"
        return
    fi

    for ((i=0; i<text_len; i++)); do
        local position=$((i * 100 / (text_len - 1)))
        local color_index=$((position * (${#colors[@]} - 1) / 100))
        result+="${colors[$color_index]}${text:$i:1}"
    done
    printf '%b' "${result}${NC}"
}

show_banner() {
    local version=$(get_version)
    local tagline="By Remco Stoeten v$version"
    local gradient_tagline=$(create_gradient_text "$tagline")

    # Android robot ASCII art with gradient colors
    local ascii_lines=(
        "    ${PASTEL_PINK}      .--.           .--.            ${NC}"
        "    ${PASTEL_MAGENTA}     /  _  \\.       /  _  \\.           ${NC}"
        "    ${PASTEL_PURPLE}     |  (_   o  _  |  (_   o  _           ${NC}"
        "    ${PASTEL_BLUE}      |   _.,----._   |   _.,----._       ${NC}"
        "    ${PASTEL_CYAN}       \\  '._'  _.'  / \\  '._'  _.'  /      ${NC}"
        "    ${PASTEL_GREEN}        '._|'--'| '._'   '._|'--'| '._'      ${NC}"
        "    ${PASTEL_PINK}            |  | |  |           |  | |  |       ${NC}"
        "    ${PASTEL_MAGENTA}          |  | |  |           |  | |  |       ${NC}"
        "    ${PASTEL_PINK}      _______________________   ${NC}"
        "    ${PASTEL_MAGENTA}     ║                     ║   ${NC}"
        "    ${PASTEL_PURPLE}     ║   ANDROID EMULATOR   ║   ${NC}"
        "    ${PASTEL_BLUE}      ╚_____________________╝   ${NC}"
    )

    # Calculate padding for centered tagline
    local max_width=0
    for line in "${ascii_lines[@]}"; do
        local clean_line=$(remove_ansi "$line")
        local line_length=${#clean_line}
        if [ $line_length -gt $max_width ]; then
            max_width=$line_length
        fi
    done

    local tagline_length=${#tagline}
    local left_pad=$(((max_width - tagline_length) / 2))

    # Print ASCII art and tagline
    for line in "${ascii_lines[@]}"; do
        echo -e "$line"
    done
    echo "$(printf ' %.0s' $(seq 1 $((left_pad + 1))))$gradient_tagline"
    echo ""
}

menu_section() {
    echo -e "${CYAN}$1${NC}"
}

menu_item() {
    printf "  ${GREEN}%-20s${NC} %s\n" "$1" "$2"
}

show_menu() {
    show_banner
    echo -e "${GREEN}Usage:${NC} android-emulator <command> [args]"
    echo ""

    menu_section "🔧 Emulator"
    menu_item "launch"            "Open Android Studio + boot the phone (-po: phone only)"
    menu_item "studio"            "Open Android Studio only"
    menu_item "start [avd]"       "Start emulator (smart device detection, or a named AVD)"
    menu_item "stop"              "Stop running emulator"
    menu_item "restart"           "Stop and restart emulator"
    menu_item "status"            "Show emulator and device status"
    menu_item "list"              "List available AVDs"
    menu_item "devices"           "List connected devices"
    echo ""

    menu_section "📦 Apps"
    menu_item "apps [filter]"     "List installed apps (-a: include system apps)"
    menu_item "app-info <pkg>"    "Show version, size and paths for an app"
    menu_item "install <apk>"     "Install an APK file"
    menu_item "uninstall <pkg>"   "Uninstall an app"
    menu_item "clear <pkg>"       "Clear an app's data and cache"
    menu_item "packages [filter]" "List raw package names"
    echo ""

    menu_section "💾 Storage"
    menu_item "storage"           "Show device storage usage per partition"
    menu_item "avd-info [avd]"    "Show AVD config: RAM, disk size, on-disk usage"
    menu_item "resize <GB> [avd]" "Set AVD data partition size (e.g. resize 16)"
    echo ""

    menu_section "🔍 Debugging"
    menu_item "logcat"            "Show device logs (live)"
    menu_item "screenshot"        "Take screenshot (saved to ~)"
    echo ""

    menu_section "🚀 Quick Launchers"
    menu_item "feeld"             "Launch Feeld (Android)"
    menu_item "govee"             "Launch Govee (Android)"
    menu_item "whatsapp"          "Launch WhatsApp (Desktop)"
    menu_item "spotify"           "Launch Spotify (Desktop)"
    echo ""

    echo -e "${YELLOW}💡 Env vars: ${CYAN}DEBUG=1${NC} verbose output  •  ${CYAN}NON_INTERACTIVE=1${NC} no prompts"
}

check_adb() {
    if [ ! -f "$adb_path" ]; then
        log_error "ADB not found at: $adb_path"
        echo -e "${YELLOW}🔧 To fix this issue:${NC}"
        echo -e "   1. Install Android Studio from: ${BLUE}https://developer.android.com/studio${NC}"
        echo -e "   2. Open Android Studio and go to ${CYAN}Settings → Appearance & Behavior → System Settings → Android SDK${NC}"
        echo -e "   3. Make sure 'Android SDK Command-line Tools (latest)' is installed"
        echo -e "   4. Verify the SDK path is: ${BLUE}$android_sdk${NC}"
        echo -e "   5. Add to your shell profile: ${CYAN}export ANDROID_HOME=$android_sdk${NC}"
        echo -e "   6. Add to PATH: ${CYAN}export PATH=\$ANDROID_HOME/platform-tools:\$PATH${NC}"
        echo ""
        echo -e "${YELLOW}💡 Or run this to add to your shell automatically:${NC}"
        echo -e "   echo 'export ANDROID_HOME=$android_sdk' >> ~/.bashrc"
        echo -e "   echo 'export PATH=\$ANDROID_HOME/platform-tools:\$PATH' >> ~/.bashrc"
        return 1
    fi
    return 0
}

check_emulator() {
    if [ ! -f "$emulator_path" ]; then
        log_error "Emulator not found at: $emulator_path"
        echo -e "${YELLOW}🔧 To fix this issue:${NC}"
        echo -e "   1. Install Android Studio from: ${BLUE}https://developer.android.com/studio${NC}"
        echo -e "   2. In Android Studio, go to ${CYAN}Tools → SDK Manager${NC}"
        echo -e "   3. Select 'SDK Tools' tab"
        echo -e "   4. Check 'Android Emulator' and click 'Apply'"
        echo -e "   5. Restart Android Studio after installation"
        return 1
    fi
    return 0
}

get_available_avds() {
    if ! check_emulator; then
        return 1
    fi

    log_debug "Getting available AVDs"
    local avds
    avds=$($emulator_path -list-avds 2>/dev/null)

    if [ -z "$avds" ]; then
        log_warning "No AVDs found"
        return 1
    fi

    echo "$avds"
    return 0
}

find_best_device() {
    log_debug "Looking for available devices"
    local available_avds
    available_avds=$(get_available_avds)

    if [ $? -ne 0 ] || [ -z "$available_avds" ]; then
        log_error "No Android Virtual Devices found!"
        echo ""
        echo -e "${YELLOW}🔧 To create an AVD:${NC}"
        echo -e "   1. Open Android Studio"
        echo -e "   2. Go to ${CYAN}Tools → Device Manager${NC}"
        echo -e "   3. Click ${CYAN}Create device${NC}"
        echo -e "   4. Select a device (e.g., Pixel 9 Pro Fold)"
        echo -e "   5. Select a system image (e.g., API 35)"
        echo -e "   6. Finish the setup"
        echo ""
        echo -e "${YELLOW}💡 Recommended devices:${NC}"
        echo -e "   • ${GREEN}Pixel 9 Pro Fold${NC} (latest)"
        echo -e "   • ${GREEN}Pixel 9 Pro${NC}"
        echo -e "   • ${GREEN}Pixel 9${NC}"
        return 1
    fi

    log_debug "Available AVDs:"
    log_debug "$available_avds"

    # Try to find preferred devices in order
    for preferred_device in "${preferred_devices[@]}"; do
        if echo "$available_avds" | grep -q "^$preferred_device$"; then
            log_success "Found preferred device: $preferred_device"
            echo "$preferred_device"
            return 0
        fi
    done

    # If no preferred device found, show all available and ask user
    log_warning "Preferred devices not found. Available devices:"
    echo ""

    local i=1
    while IFS= read -r device; do
        echo -e "   ${BLUE}$i)${NC} $device"
        i=$((i + 1))
    done <<< "$available_avds"

    echo ""
    echo -e "${YELLOW}💡 To set a preferred device, you can:${NC}"
    echo -e "   1. ${CYAN}Choose from the list above${NC} (enter number)"
    echo -e "   2. ${CYAN}Rename your AVD${NC} to match preferred names:"
    echo -e "      ${MAGENTA}Pixel_9_Pro_Fold${NC}, ${MAGENTA}Pixel_9_Pro${NC}, etc."

    return 2  # Special return code to indicate user interaction needed
}

prompt_user_device_selection() {
    local available_avds
    available_avds=$(get_available_avds)

    echo ""
    echo -e "${CYAN}📱 Please select a device to start:${NC}"
    echo ""

    local i=1
    while IFS= read -r device; do
        echo -e "   ${BLUE}$i)${NC} $device"
        i=$((i + 1))
    done <<< "$available_avds"

    echo ""
    echo -e "${YELLOW}Enter device number (1-$((i-1))) or press Enter for default: ${NC}"
    read -r user_choice

    if [ -z "$user_choice" ]; then
        # Use first device as default
        echo "$available_avds" | head -n1
        return 0
    fi

    if [[ "$user_choice" =~ ^[0-9]+$ ]] && [ "$user_choice" -ge 1 ] && [ "$user_choice" -lt "$i" ]; then
        local selected_device
        selected_device=$(echo "$available_avds" | sed -n "${user_choice}p")
        echo "$selected_device"
        return 0
    else
        log_error "Invalid selection. Please enter a number between 1 and $((i-1))"
        return 1
    fi
}

get_devices() {
    local count=$($adb_path devices 2>/dev/null | tail -n +2 | grep -v '^$' | wc -l)
    echo "$count" | tr -d ' '
}

is_emulator_running() {
    [ "$(get_devices)" -gt 0 ]
}

cmd_start() {
    if ! check_emulator; then
        return 1
    fi

    if ! check_adb; then
        return 1
    fi

    if is_emulator_running; then
        log_success "Emulator is already running"
        log_info "Run 'android-emulator stop' to stop it first"
        return 0
    fi

    local requested_device=""
    if [ "$1" = "start" ]; then
        requested_device="$2"
    fi

    local selected_device
    local device_selection_result
    if [ -n "$requested_device" ]; then
        selected_device=$(resolve_avd_name "$requested_device") || return 1
        device_selection_result=0
    else
        log_info "Looking for available Android emulators..."
        selected_device=$(find_best_device)
        device_selection_result=$?
    fi

    case $device_selection_result in
        1)
            # No devices found
            log_error "Cannot start emulator - no AVDs available"
            return 1
            ;;
        2)
            # User needs to select device
            if [ "${NON_INTERACTIVE:-0}" = "1" ]; then
                log_error "Non-interactive mode: no preferred devices found"
                return 1
            fi

            selected_device=$(prompt_user_device_selection)
            if [ $? -ne 0 ]; then
                log_error "Invalid device selection"
                return 1
            fi
            ;;
        0)
            # Found preferred device
            log_success "Using device: $selected_device"
            ;;
    esac

    if [ -z "$selected_device" ]; then
        log_error "No device selected"
        return 1
    fi

    log_info "🚀 Starting Android emulator: $selected_device"
    log_info "Starting in optimized mode..."

    # Start with optimizations in background. Quick-boot snapshot is left
    # enabled (no -no-snapshot-load) so subsequent launches resume instantly.
    nohup $emulator_path -avd "$selected_device" \
        -no-boot-anim \
        -no-audio \
        -gpu host \
        -accel on \
        >/dev/null 2>&1 &

    local emulator_pid=$!
    log_debug "Emulator started with PID: $emulator_pid"

    log_info "⏳ Waiting for emulator to boot..."

    # Wait for boot completion with better progress indication
    local timeout=120
    local elapsed=0
    local progress_interval=10

    while [ $elapsed -lt $timeout ]; do
        if is_emulator_running; then
            local boot_complete
            boot_complete=$($adb_path shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')
            if [ "$boot_complete" = "1" ]; then
                log_success "Emulator is ready! 🎉"
                log_info "Device: $selected_device"
                log_info "You can now run Android apps on this emulator"

                # Show device info
                echo ""
                echo -e "${CYAN}📱 Device Information:${NC}"
                echo -e "   Name: ${GREEN}$selected_device${NC}"
                echo -e "   Status: ${GREEN}Running${NC}"
                echo -e "   ADB: ${BLUE}adb devices${NC}"
                echo ""
                echo -e "${YELLOW}💡 Useful commands:${NC}"
                echo -e "   • android-emulator status   - Check status"
                echo -e "   • android-emulator logcat    - View logs"
                echo -e "   • android-emulator packages - List apps"

                return 0
            fi
        fi

        # Progress indicator
        if [ $((elapsed % progress_interval)) -eq 0 ] && [ $elapsed -gt 0 ]; then
            log_info "Still booting... ($elapsed/${timeout}s)"
        fi

        sleep 1
        elapsed=$((elapsed + 1))
    done

    echo ""
    log_error "Emulator took too long to start (timeout: ${timeout}s)"
    echo ""
    echo -e "${YELLOW}🔧 Troubleshooting tips:${NC}"
    echo -e "   1. Check if emulator is hung: ${CYAN}android-emulator status${NC}"
    echo -e "   2. Try restarting: ${CYAN}android-emulator stop && android-emulator start${NC}"
    echo -e "   3. Increase memory in Android Studio Device Manager"
    echo -e "   4. Try with different AVD"
    echo -e "   5. Check system resources (RAM, CPU)"

    # Clean up the failed process
    if [ -n "$emulator_pid" ]; then
        kill "$emulator_pid" 2>/dev/null
    fi

    return 1
}

cmd_stop() {
    if ! check_adb; then
        return 1
    fi

    if ! is_emulator_running; then
        echo -e "${YELLOW}⚠️  No emulator is running${NC}"
        return 0
    fi

    echo -e "${YELLOW}🛑 Stopping emulator...${NC}"

    $adb_path emu kill >/dev/null 2>&1

    echo -e "${GREEN}✅ Emulator stopped${NC}"
}

cmd_status() {
    if ! check_adb; then
        return 1
    fi

    echo -e "${CYAN}📱 Android Emulator Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    if is_emulator_running; then
        log_success "Emulator is running"

        # Get device information
        local devices
        devices=$($adb_path devices 2>/dev/null | tail -n +2 | grep -v '^$')

        if [ -n "$devices" ]; then
            echo -e "${YELLOW}Connected devices:${NC}"
            echo "$devices"

            # Get additional device info
            while IFS= read -r device_line; do
                if [ -n "$device_line" ]; then
                    local device_id
                    device_id=$(echo "$device_line" | awk '{print $1}')

                    echo ""
                    echo -e "${CYAN}Device Info for $device_id:${NC}"

                    # Get device model
                    local model
                    model=$($adb_path -s "$device_id" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
                    echo -e "   Model: ${GREEN}$model${NC}"

                    # Get Android version
                    local android_version
                    android_version=$($adb_path -s "$device_id" shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')
                    echo -e "   Android: ${GREEN}$android_version${NC}"

                    # Get API level
                    local api_level
                    api_level=$($adb_path -s "$device_id" shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r')
                    echo -e "   API Level: ${GREEN}$api_level${NC}"

                    # Get boot status
                    local boot_complete
                    boot_complete=$($adb_path -s "$device_id" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')
                    if [ "$boot_complete" = "1" ]; then
                        echo -e "   Status: ${GREEN}Ready${NC}"
                    else
                        echo -e "   Status: ${YELLOW}Booting...${NC}"
                    fi
                fi
            done <<< "$devices"
        fi
    else
        log_error "No emulator running"
        echo ""
        echo -e "${YELLOW}💡 To start an emulator:${NC}"
        echo -e "   ${CYAN}android-emulator start${NC}"

        # Show available devices
        local available_avds
        available_avds=$(get_available_avds 2>/dev/null)
        if [ -n "$available_avds" ]; then
            echo ""
            echo -e "${YELLOW}💡 Available devices:${NC}"
            while IFS= read -r avd; do
                echo -e "   • ${GREEN}$avd${NC}"
            done <<< "$available_avds"
        fi
    fi
}

cmd_restart() {
    log_info "Restarting Android emulator..."
    cmd_stop
    sleep 2
    cmd_start
}

cmd_list() {
    if ! check_emulator; then
        return 1
    fi

    echo -e "${CYAN}📱 Available Android Virtual Devices:${NC}"
    echo ""
    $emulator_path -list-avds
    echo ""
}

cmd_devices() {
    if ! check_adb; then
        return 1
    fi

    echo -e "${CYAN}📱 Connected Devices:${NC}"
    echo ""
    $adb_path devices
}

cmd_packages() {
    if ! check_adb; then
        return 1
    fi

    if ! is_emulator_running; then
        echo -e "${RED}❌ No emulator running${NC}"
        echo -e "${YELLOW}💡 Start an emulator first${NC}"
        return 1
    fi

    echo -e "${CYAN}📦 Installed Packages on Emulator:${NC}"
    echo ""

    if [ $# -gt 1 ]; then
        echo -e "${YELLOW}Searching for: $2${NC}"
        $adb_path shell pm list packages | grep -i "$2" | cut -d: -f2 | sort
    else
        $adb_path shell pm list packages -3 | cut -d: -f2 | sort
    fi
}

cmd_logcat() {
    if ! check_adb; then
        return 1
    fi

    if ! is_emulator_running; then
        echo -e "${RED}❌ No emulator running${NC}"
        return 1
    fi

    echo -e "${YELLOW}📋 Showing live logs (Ctrl+C to exit)...${NC}"
    echo ""

    $adb_path logcat
}

cmd_screenshot() {
    if ! check_adb; then
        return 1
    fi

    if ! is_emulator_running; then
        echo -e "${RED}❌ No emulator running${NC}"
        return 1
    fi

    filename="screenshot-$(date +%Y%m%d-%H%M%S).png"
    path="$HOME/$filename"

    $adb_path shell screencap -p > "$path" 2>/dev/null

    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✅ Screenshot saved: $path${NC}"
    else
        echo -e "${RED}❌ Failed to take screenshot${NC}"
    fi
}

require_running() {
    if ! check_adb; then
        return 1
    fi

    if ! is_emulator_running; then
        log_error "No emulator running"
        echo -e "${YELLOW}💡 Start one first: ${CYAN}android-emulator start${NC}"
        return 1
    fi
    return 0
}

get_avd_home() {
    if [ -n "$ANDROID_AVD_HOME" ] && [ -d "$ANDROID_AVD_HOME" ]; then
        echo "$ANDROID_AVD_HOME"
    elif [ -d "$HOME/.android/avd" ]; then
        echo "$HOME/.android/avd"
    else
        return 1
    fi
}

resolve_avd_name() {
    local requested="$1"
    local avds
    avds=$(get_available_avds) || return 1

    if [ -n "$requested" ]; then
        if echo "$avds" | grep -q "^$requested$"; then
            echo "$requested"
            return 0
        fi
        log_error "AVD not found: $requested"
        echo -e "${YELLOW}Available AVDs:${NC}" >&2
        echo "$avds" >&2
        return 1
    fi

    local count
    count=$(echo "$avds" | wc -l)
    if [ "$count" -eq 1 ]; then
        echo "$avds"
        return 0
    fi

    if [ "${NON_INTERACTIVE:-0}" = "1" ]; then
        log_error "Multiple AVDs found; specify one explicitly"
        echo "$avds" >&2
        return 1
    fi

    echo "" >&2
    echo -e "${CYAN}📱 Select an AVD:${NC}" >&2
    local i=1
    while IFS= read -r avd; do
        echo -e "   ${BLUE}$i)${NC} $avd" >&2
        i=$((i + 1))
    done <<< "$avds"
    echo "" >&2
    printf "Enter number (1-%d): " $((i - 1)) >&2
    read -r choice

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -lt "$i" ]; then
        echo "$avds" | sed -n "${choice}p"
        return 0
    fi

    log_error "Invalid selection"
    return 1
}

cmd_apps() {
    require_running || return 1

    local include_system=0
    local filter=""
    shift
    for arg in "$@"; do
        case "$arg" in
            -a|--all) include_system=1 ;;
            *) filter="$arg" ;;
        esac
    done

    local pm_flags="-3"
    if [ "$include_system" -eq 1 ]; then
        pm_flags=""
    fi

    echo -e "${CYAN}📦 Installed Apps:${NC}"
    echo ""

    local packages
    packages=$($adb_path shell pm list packages $pm_flags 2>/dev/null | cut -d: -f2 | tr -d '\r' | sort)

    if [ -n "$filter" ]; then
        packages=$(echo "$packages" | grep -i "$filter")
    fi

    if [ -z "$packages" ]; then
        log_warning "No apps found${filter:+ matching '$filter'}"
        return 0
    fi

    echo "$packages" | while IFS= read -r pkg; do
        echo -e "   • ${GREEN}$pkg${NC}"
    done

    echo ""
    local count
    count=$(echo "$packages" | wc -l)
    echo -e "${YELLOW}Total: $count app(s)${NC}"
    echo -e "${YELLOW}💡 Details: ${CYAN}android-emulator app-info <package>${NC}"
}

cmd_app_info() {
    require_running || return 1

    local pkg="$2"
    if [ -z "$pkg" ]; then
        log_error "Usage: android-emulator app-info <package>"
        return 1
    fi

    if ! $adb_path shell pm list packages 2>/dev/null | tr -d '\r' | grep -q "^package:$pkg$"; then
        log_error "Package not installed: $pkg"
        return 1
    fi

    echo -e "${CYAN}📦 App Info: ${GREEN}$pkg${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    local dump
    dump=$($adb_path shell dumpsys package "$pkg" 2>/dev/null | tr -d '\r')

    local version
    version=$(echo "$dump" | grep -m1 'versionName=' | sed 's/.*versionName=//')
    echo -e "   Version:      ${GREEN}${version:-unknown}${NC}"

    local sdk
    sdk=$(echo "$dump" | grep -m1 'targetSdk=' | sed 's/.*targetSdk=\([0-9]*\).*/\1/')
    echo -e "   Target SDK:   ${GREEN}${sdk:-unknown}${NC}"

    local installed
    installed=$(echo "$dump" | grep -m1 'firstInstallTime=' | sed 's/.*firstInstallTime=//')
    echo -e "   Installed:    ${GREEN}${installed:-unknown}${NC}"

    local apk_path
    apk_path=$($adb_path shell pm path "$pkg" 2>/dev/null | head -n1 | cut -d: -f2 | tr -d '\r')
    if [ -n "$apk_path" ]; then
        local apk_size
        apk_size=$($adb_path shell "du -h '$apk_path' 2>/dev/null | cut -f1" | tr -d '\r')
        echo -e "   APK:          ${BLUE}$apk_path${NC} (${GREEN}${apk_size:-?}${NC})"
    fi

    local data_dir
    data_dir=$(echo "$dump" | grep -m1 'dataDir=' | sed 's/.*dataDir=//')
    if [ -n "$data_dir" ]; then
        echo -e "   Data dir:     ${BLUE}$data_dir${NC}"
    fi
}

cmd_install() {
    require_running || return 1

    local apk="$2"
    if [ -z "$apk" ]; then
        log_error "Usage: android-emulator install <path-to-apk>"
        return 1
    fi

    if [ ! -f "$apk" ]; then
        log_error "APK file not found: $apk"
        return 1
    fi

    log_info "Installing $(basename "$apk")..."
    if $adb_path install -r "$apk"; then
        log_success "Installed $(basename "$apk")"
    else
        log_error "Install failed"
        return 1
    fi
}

cmd_uninstall() {
    require_running || return 1

    local pkg="$2"
    if [ -z "$pkg" ]; then
        log_error "Usage: android-emulator uninstall <package>"
        echo -e "${YELLOW}💡 Find packages with: ${CYAN}android-emulator apps${NC}"
        return 1
    fi

    if ! $adb_path shell pm list packages 2>/dev/null | tr -d '\r' | grep -q "^package:$pkg$"; then
        log_error "Package not installed: $pkg"
        return 1
    fi

    if [ "${NON_INTERACTIVE:-0}" != "1" ]; then
        printf "Uninstall %s? [y/N] " "$pkg"
        read -r confirm
        case "$confirm" in
            y|Y|yes) ;;
            *) log_info "Aborted"; return 0 ;;
        esac
    fi

    if $adb_path uninstall "$pkg" >/dev/null 2>&1; then
        log_success "Uninstalled $pkg"
    else
        log_error "Failed to uninstall $pkg (system apps can't be removed)"
        return 1
    fi
}

cmd_clear() {
    require_running || return 1

    local pkg="$2"
    if [ -z "$pkg" ]; then
        log_error "Usage: android-emulator clear <package>"
        return 1
    fi

    if [ "${NON_INTERACTIVE:-0}" != "1" ]; then
        printf "Clear all data and cache for %s? [y/N] " "$pkg"
        read -r confirm
        case "$confirm" in
            y|Y|yes) ;;
            *) log_info "Aborted"; return 0 ;;
        esac
    fi

    local result
    result=$($adb_path shell pm clear "$pkg" 2>/dev/null | tr -d '\r')
    if [ "$result" = "Success" ]; then
        log_success "Cleared data for $pkg"
    else
        log_error "Failed to clear data for $pkg"
        return 1
    fi
}

cmd_storage() {
    require_running || return 1

    echo -e "${CYAN}💾 Device Storage${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    echo -e "${YELLOW}Partitions:${NC}"
    $adb_path shell df -h /data /storage/emulated 2>/dev/null | tr -d '\r'
    echo ""

    echo -e "${YELLOW}Data usage breakdown:${NC}"
    $adb_path shell dumpsys diskstats 2>/dev/null | tr -d '\r' | grep -E '^(Data-Free|Cache-Free|App Size|App Data Size|App Cache Size|Photos Size|Videos Size|Audio Size|Downloads Size|System Size|Other Size):' | while IFS= read -r line; do
        echo -e "   $line"
    done
    echo ""
    echo -e "${YELLOW}💡 Resize data partition: ${CYAN}android-emulator resize <GB>${NC}"
}

cmd_avd_info() {
    if ! check_emulator; then
        return 1
    fi

    local avd_home
    avd_home=$(get_avd_home)
    if [ $? -ne 0 ]; then
        log_error "AVD home directory not found"
        return 1
    fi

    local requested="$2"
    local avds
    avds=$(get_available_avds) || return 1

    if [ -n "$requested" ]; then
        avds="$requested"
    fi

    while IFS= read -r avd; do
        local config="$avd_home/$avd.avd/config.ini"
        if [ ! -f "$config" ]; then
            log_error "Config not found for AVD: $avd"
            continue
        fi

        echo -e "${CYAN}📱 ${GREEN}$avd${NC}"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

        local ram heap data_size resolution api
        ram=$(grep -m1 '^hw.ramSize' "$config" | cut -d= -f2 | tr -d ' ')
        heap=$(grep -m1 '^vm.heapSize' "$config" | cut -d= -f2 | tr -d ' ')
        data_size=$(grep -m1 '^disk.dataPartition.size' "$config" | cut -d= -f2 | tr -d ' ')
        resolution="$(grep -m1 '^hw.lcd.width' "$config" | cut -d= -f2 | tr -d ' ')x$(grep -m1 '^hw.lcd.height' "$config" | cut -d= -f2 | tr -d ' ')"
        api=$(grep -m1 '^image.sysdir.1' "$config" | grep -o 'android-[0-9]*' | head -n1)

        echo -e "   RAM:            ${GREEN}${ram:-?} MB${NC}"
        echo -e "   VM heap:        ${GREEN}${heap:-?} MB${NC}"
        echo -e "   Data partition: ${GREEN}${data_size:-default}${NC}"
        echo -e "   Resolution:     ${GREEN}${resolution}${NC}"
        echo -e "   System image:   ${GREEN}${api:-unknown}${NC}"

        local on_disk
        on_disk=$(du -sh "$avd_home/$avd.avd" 2>/dev/null | cut -f1)
        echo -e "   On-disk size:   ${GREEN}${on_disk:-?}${NC} ${BLUE}($avd_home/$avd.avd)${NC}"
        echo ""
    done <<< "$avds"
}

cmd_resize() {
    if ! check_emulator; then
        return 1
    fi

    local size_gb="$2"
    if [ -z "$size_gb" ] || ! [[ "$size_gb" =~ ^[0-9]+$ ]] || [ "$size_gb" -lt 2 ]; then
        log_error "Usage: android-emulator resize <GB> [avd]  (minimum 2 GB)"
        echo -e "${YELLOW}💡 Example: ${CYAN}android-emulator resize 16${NC}"
        return 1
    fi

    local avd
    avd=$(resolve_avd_name "$3") || return 1

    local avd_home
    avd_home=$(get_avd_home)
    if [ $? -ne 0 ]; then
        log_error "AVD home directory not found"
        return 1
    fi

    local config="$avd_home/$avd.avd/config.ini"
    if [ ! -f "$config" ]; then
        log_error "Config not found: $config"
        return 1
    fi

    if is_emulator_running; then
        log_error "Stop the emulator first: android-emulator stop"
        return 1
    fi

    local current
    current=$(grep -m1 '^disk.dataPartition.size' "$config" | cut -d= -f2 | tr -d ' ')
    log_info "AVD: $avd"
    log_info "Current data partition size: ${current:-default}"

    if grep -q '^disk.dataPartition.size' "$config"; then
        sed -i "s/^disk.dataPartition.size.*/disk.dataPartition.size=${size_gb}G/" "$config"
    else
        echo "disk.dataPartition.size=${size_gb}G" >> "$config"
    fi

    log_success "Data partition size set to ${size_gb}G"
    echo ""
    log_warning "The emulator grows the partition on next boot. If the new size"
    log_warning "doesn't apply (especially when shrinking), wipe user data:"
    echo -e "   ${CYAN}$emulator_path -avd $avd -wipe-data${NC}"
    echo -e "   ${RED}(wipe-data erases all apps and data on the device)${NC}"
}

feeld_avd="Pixel_6_API_35"
feeld_package="co.feeld"

cmd_feeld() {
    if ! is_emulator_running; then
        cmd_start start "$feeld_avd" || return 1
    fi
    log_info "Launching Feeld"
    $adb_path shell monkey -p "$feeld_package" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
}

cmd_govee() {
    # Use the govee function (must be available in fish shell)
    govee
}

cmd_whatsapp() {
    # Use the whatsapp function from apps.fish
    fish -c "whatsapp"
}

cmd_spotify() {
    # Use the spotify function from apps.fish
    fish -c "spotify"
}

cmd_studio() {
    if [ ! -f "$studio_path" ]; then
        log_error "Android Studio not found at: $studio_path"
        return 1
    fi

    log_info "🚀 Launching Android Studio..."
    nohup "$studio_path" >/dev/null 2>&1 &
    disown
}

cmd_launch() {
    local phone_only=0
    for arg in "$@"; do
        case "$arg" in
            --phoneonly|-po)
                phone_only=1
                ;;
        esac
    done

    if [ "$phone_only" -eq 0 ]; then
        cmd_studio
    fi

    cmd_start
}

# Main command handler
if [ $# -eq 0 ]; then
    show_menu
    exit 0
fi

command="$1"

case "$command" in
    --phoneonly|-po)
        cmd_start
        exit $?
        ;;
    launch)
        cmd_launch "$@"
        ;;
    studio)
        cmd_studio "$@"
        ;;
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    restart)
        cmd_restart "$@"
        ;;
    status)
        cmd_status "$@"
        ;;
    list)
        cmd_list "$@"
        ;;
    devices)
        cmd_devices "$@"
        ;;
    packages)
        cmd_packages "$@"
        ;;
    logcat)
        cmd_logcat "$@"
        ;;
    screenshot)
        cmd_screenshot "$@"
        ;;
    apps)
        cmd_apps "$@"
        ;;
    app-info|appinfo)
        cmd_app_info "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    uninstall|remove)
        cmd_uninstall "$@"
        ;;
    clear)
        cmd_clear "$@"
        ;;
    storage|disk)
        cmd_storage "$@"
        ;;
    avd-info|avdinfo)
        cmd_avd_info "$@"
        ;;
    resize)
        cmd_resize "$@"
        ;;
    feeld)
        cmd_feeld "$@"
        ;;
    govee)
        cmd_govee "$@"
        ;;
    whatsapp)
        cmd_whatsapp "$@"
        ;;
    spotify)
        cmd_spotify "$@"
        ;;
    --help|-h|help)
        show_menu
        ;;
    *)
        echo -e "${RED}❌ Unknown command: $command${NC}"
        echo ""
        show_menu
        exit 1
        ;;
esac
