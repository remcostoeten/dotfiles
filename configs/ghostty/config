# Shell
command = /usr/bin/fish


# Background
background-opacity = 0.9
background-opacity-cells = false
background-blur = true

background-image = 
background-image-opacity = 1.00
background-image-fit = cover


# Theme
theme = pocket
cursor-style = block
cursor-style-blink = false
bold-is-bright = false
minimum-contrast = 1.1
unfocused-split-opacity = 0.85


# Window Appearance
window-decoration = none
gtk-titlebar = true
window-show-tab-bar = auto
gtk-toolbar-style = flat
gtk-custom-css = gtk.css
gtk-custom-css = themes/pocket-gtk.css
window-padding-x = 28
window-padding-y = 24
window-padding-balance = true


# Font & Typography
font-family = "CommitMono Nerd Font"
font-size = 14
adjust-cell-height = 20%


# Terminal Behavior
confirm-close-surface = false


# Window Behavior
window-width = 120
window-height = 40
window-save-state = always

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true


# Clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard


# Tabs & Windows
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+shift+n=new_window

keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab


# Font Size
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size


# Terminal Actions
keybind = ctrl+shift+l=clear_screen
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+b=toggle_background_opacity
keybind = ctrl+shift+s=prompt_surface_title


# Window Controls
# Toggle between maximized and normal window size
keybind = ctrl+enter=toggle_maximize


# Quick Terminal
# Global shortcut, works even when Ghostty is not focused
# Ctrl + Shift + ` toggles the dropdown terminal
keybind = global:ctrl+shift+backquote=toggle_quick_terminal


# Split Navigation
# Cycle through existing splits
keybind = ctrl+backquote=goto_split:next

# Ctrl + [ cycles clockwise, Ctrl + ] counterclockwise
# performable: only consumes the key when splits exist, so Ctrl + [ still sends Escape otherwise
keybind = performable:ctrl+bracket_left=goto_split:next
keybind = performable:ctrl+bracket_right=goto_split:previous


# Split Creation
# Create a split to the right
keybind = ctrl+h=new_split:right

# Create a split below
keybind = ctrl+shift+h=new_split:down


# Split Resizing
# Resize the active split by 40 cells
keybind = ctrl+shift+bracket_right=resize_split:right,40
keybind = ctrl+shift+bracket_left=resize_split:left,40
keybind = ctrl+shift+arrow_down=resize_split:down,40
keybind = ctrl+shift+arrow_up=resize_split:up,40


# Split Layout
# Make all current splits equal in size
keybind = ctrl+shift+e=equalize_splits


# Mouse
mouse-hide-while-typing = true
copy-on-select = true

config-file = ?/home/remcostoeten/.config/aether/theme/ghostty.conf
adjust-cell-width = 0%
