{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/dotfiles/configs/fastfetch/logos/noir.txt",
        "color": {
            "1": "#ff6b2c"
        },
        "padding": {
            "top": 2,
            "left": 3,
            "right": 6
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#3a3a3a",
            "output": "#e6e1d6",
            "separator": "#8f897f"
        },
        "percent": {
            "type": 3,
            "color": {
                "green": "#9ccf8f",
                "yellow": "#f5c065",
                "red": "#ff6b2c"
            }
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#38;2;58;58;58}┌─────────────────{#38;2;255;107;44}Hardware{#38;2;58;58;58}─────────────────┐"
        },
        {
            "type": "host",
            "key": "│ 󰌢 :",
            "format": "{name}",
            "keyColor": "#ff6b2c"
        },
        {
            "type": "cpu",
            "key": "│  :",
            "format": "{name} ({cores-logical}) @ {freq-max}",
            "keyColor": "#f5c065"
        },
        {
            "type": "gpu",
            "key": "│ 󰢮 :",
            "format": "{name} [{type}]",
            "keyColor": "#9ccf8f"
        },
        {
            "type": "display",
            "key": "│ 󰍹 :",
            "format": "{width}x{height} @ {refresh-rate} Hz",
            "keyColor": "#6fcfbf"
        },
        {
            "type": "disk",
            "key": "│ 󰋊 :",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}",
            "keyColor": "#7aaef0"
        },
        {
            "type": "memory",
            "key": "│  :",
            "keyColor": "#c79af2"
        },
        {
            "type": "swap",
            "key": "│ 󰓡 :",
            "keyColor": "#f08aa8"
        },
        {
            "type": "custom",
            "format": "{#38;2;58;58;58}└──────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;58;58;58}┌─────────────────{#38;2;255;107;44}Software{#38;2;58;58;58}─────────────────┐"
        },
        {
            "type": "os",
            "key": "│ 󰣇 :",
            "format": "{pretty-name}",
            "keyColor": "#ff6b2c"
        },
        {
            "type": "de",
            "key": "│ 󰧨 :",
            "keyColor": "#f5c065"
        },
        {
            "type": "wm",
            "key": "│  :",
            "format": "{pretty-name} ({protocol-name})",
            "keyColor": "#9ccf8f"
        },
        {
            "type": "kernel",
            "key": "│  :",
            "format": "Linux {release}",
            "keyColor": "#6fcfbf"
        },
        {
            "type": "shell",
            "key": "│  :",
            "keyColor": "#7aaef0"
        },
        {
            "type": "terminal",
            "key": "│  :",
            "keyColor": "#c79af2"
        },
        {
            "type": "packages",
            "key": "│ 󰏖 :",
            "format": "{pacman} (pacman), {flatpak-system} (flatpak-system), {flatpak-user} (flatpak-user)",
            "keyColor": "#f08aa8"
        },
        {
            "type": "custom",
            "key": "│ 󰏘 :",
            "format": "Noir {#38;2;230;225;214}●{#38;2;255;107;44}●●{#38;2;245;192;101}●{#38;2;156;207;143}●{#38;2;143;137;127}●",
            "keyColor": "#ff6b2c"
        },
        {
            "type": "terminalfont",
            "key": "│  :",
            "keyColor": "#f5c065"
        },
        {
            "type": "custom",
            "format": "{#38;2;58;58;58}└──────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;58;58;58}┌──────────{#38;2;255;107;44}Age / Uptime / Update{#38;2;58;58;58}───────────┐"
        },
        {
            "type": "command",
            "key": "│ 󱦟 :",
            "text": "birth=$(stat -c %W /); echo \"OS Age: $(( ($(date +%s) - birth) / 86400 )) days\"",
            "keyColor": "#9ccf8f"
        },
        {
            "type": "uptime",
            "key": "│ 󰔟 :",
            "format": "Uptime: {?days}{days} days, {?}{hours} hours, {minutes} mins",
            "keyColor": "#6fcfbf"
        },
        {
            "type": "command",
            "key": "│ 󰚰 :",
            "text": "n=$(checkupdates 2>/dev/null | wc -l); echo \"Updates: $n pending\"",
            "keyColor": "#7aaef0"
        },
        {
            "type": "custom",
            "format": "{#38;2;58;58;58}└──────────────────────────────────────────┘"
        }
    ]
}
