{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/dotfiles/configs/fastfetch/logos/noir.txt",
        "color": {
            "1": "#e1c46d"
        },
        "padding": {
            "top": 2,
            "left": 3,
            "right": 6
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#4c4639",
            "output": "#e9e2d4",
            "separator": "#979080"
        },
        "percent": {
            "type": 3,
            "color": {
                "green": "#aed18d",
                "yellow": "#e8c26c",
                "red": "#e1c46d"
            }
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#38;2;76;70;57}┌─────────────────{#38;2;225;196;109}Hardware{#38;2;76;70;57}─────────────────┐"
        },
        {
            "type": "host",
            "key": "│ 󰌢 :",
            "format": "{name}",
            "keyColor": "#e1c46d"
        },
        {
            "type": "cpu",
            "key": "│  :",
            "format": "{name} ({cores-logical}) @ {freq-max}",
            "keyColor": "#e8c26c"
        },
        {
            "type": "gpu",
            "key": "│ 󰢮 :",
            "format": "{name} [{type}]",
            "keyColor": "#aed18d"
        },
        {
            "type": "display",
            "key": "│ 󰍹 :",
            "format": "{width}x{height} @ {refresh-rate} Hz",
            "keyColor": "#8bd6b5"
        },
        {
            "type": "disk",
            "key": "│ 󰋊 :",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}",
            "keyColor": "#c5c0ff"
        },
        {
            "type": "memory",
            "key": "│  :",
            "keyColor": "#eab5ed"
        },
        {
            "type": "swap",
            "key": "│ 󰓡 :",
            "keyColor": "#ffb1c3"
        },
        {
            "type": "custom",
            "format": "{#38;2;76;70;57}└──────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;76;70;57}┌─────────────────{#38;2;225;196;109}Software{#38;2;76;70;57}─────────────────┐"
        },
        {
            "type": "os",
            "key": "│ 󰣇 :",
            "format": "{pretty-name}",
            "keyColor": "#e1c46d"
        },
        {
            "type": "de",
            "key": "│ 󰧨 :",
            "keyColor": "#e8c26c"
        },
        {
            "type": "wm",
            "key": "│  :",
            "format": "{pretty-name} ({protocol-name})",
            "keyColor": "#aed18d"
        },
        {
            "type": "kernel",
            "key": "│  :",
            "format": "Linux {release}",
            "keyColor": "#8bd6b5"
        },
        {
            "type": "shell",
            "key": "│  :",
            "keyColor": "#c5c0ff"
        },
        {
            "type": "terminal",
            "key": "│  :",
            "keyColor": "#eab5ed"
        },
        {
            "type": "packages",
            "key": "│ 󰏖 :",
            "format": "{pacman} (pacman), {flatpak-system} (flatpak-system), {flatpak-user} (flatpak-user)",
            "keyColor": "#ffb1c3"
        },
        {
            "type": "custom",
            "key": "│ 󰏘 :",
            "format": "Pocket {#38;2;233;226;212}●{#38;2;225;196;109}●●{#38;2;232;194;108}●{#38;2;174;209;141}●{#38;2;151;144;128}●",
            "keyColor": "#e1c46d"
        },
        {
            "type": "terminalfont",
            "key": "│  :",
            "keyColor": "#e8c26c"
        },
        {
            "type": "custom",
            "format": "{#38;2;76;70;57}└──────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;76;70;57}┌──────────{#38;2;225;196;109}Age / Uptime / Update{#38;2;76;70;57}───────────┐"
        },
        {
            "type": "command",
            "key": "│ 󱦟 :",
            "text": "birth=$(stat -c %W /); echo \"OS Age: $(( ($(date +%s) - birth) / 86400 )) days\"",
            "keyColor": "#aed18d"
        },
        {
            "type": "uptime",
            "key": "│ 󰔟 :",
            "format": "Uptime: {?days}{days} days, {?}{hours} hours, {minutes} mins",
            "keyColor": "#8bd6b5"
        },
        {
            "type": "command",
            "key": "│ 󰚰 :",
            "text": "n=$(checkupdates 2>/dev/null | wc -l); echo \"Updates: $n pending\"",
            "keyColor": "#c5c0ff"
        },
        {
            "type": "custom",
            "format": "{#38;2;76;70;57}└──────────────────────────────────────────┘"
        }
    ]
}
