{
    "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
    "name": "Pocket",
    "author": "matugen",
    "themes": [
        {
            "name": "Pocket",
            "appearance": "dark",
            "style": {
                "background": "{{colors.surface_container.default.hex}}",
                "surface.background": "{{colors.surface_container_low.default.hex}}",
                "elevated_surface.background": "{{colors.surface_container_high.default.hex}}",
                "panel.background": "{{colors.surface_container_low.default.hex}}",
                "panel.focused_border": "{{colors.primary.default.hex}}",
                "border": "{{colors.surface_container_highest.default.hex}}",
                "border.variant": "{{colors.surface_container_high.default.hex}}",
                "border.focused": "{{colors.primary.default.hex}}",
                "border.selected": "{{colors.primary.default.hex}}",
                "text": "{{colors.on_surface.default.hex}}",
                "text.muted": "{{colors.on_surface_variant.default.hex}}",
                "text.placeholder": "{{colors.outline.default.hex}}",
                "text.disabled": "{{colors.outline.default.hex}}",
                "text.accent": "{{colors.primary.default.hex}}",
                "icon": "{{colors.on_surface_variant.default.hex}}",
                "icon.accent": "{{colors.primary.default.hex}}",
                "element.background": "{{colors.surface_container_high.default.hex}}",
                "element.hover": "{{colors.surface_container_highest.default.hex}}",
                "element.selected": "{{colors.primary_container.default.hex}}",
                "ghost_element.hover": "{{colors.surface_container_high.default.hex}}",
                "ghost_element.selected": "{{colors.surface_container_highest.default.hex}}",
                "title_bar.background": "{{colors.surface_container_lowest.default.hex}}",
                "title_bar.inactive_background": "{{colors.surface_container_lowest.default.hex}}",
                "toolbar.background": "{{colors.surface.default.hex}}",
                "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
                "tab.active_background": "{{colors.surface.default.hex}}",
                "tab.inactive_background": "{{colors.surface_container_low.default.hex}}",
                "status_bar.background": "{{colors.surface_container_lowest.default.hex}}",
                "scrollbar.thumb.background": "{{colors.outline_variant.default.hex_alpha | set_alpha: 0.6}}",
                "scrollbar.track.background": "{{colors.surface.default.hex}}",
                "editor.background": "{{colors.surface.default.hex}}",
                "editor.foreground": "{{colors.on_surface.default.hex}}",
                "editor.gutter.background": "{{colors.surface.default.hex}}",
                "editor.active_line.background": "{{colors.surface_container_low.default.hex}}",
                "editor.line_number": "{{colors.outline_variant.default.hex}}",
                "editor.active_line_number": "{{colors.primary.default.hex}}",
                "editor.indent_guide": "{{colors.surface_container_high.default.hex}}",
                "editor.indent_guide_active": "{{colors.outline_variant.default.hex}}",
                "search.match_background": "{{colors.tertiary_container.default.hex}}",
                "terminal.background": "{{colors.surface.default.hex}}",
                "terminal.foreground": "{{colors.on_surface.default.hex}}",
                "terminal.ansi.black": "{{colors.surface_container_high.default.hex}}",
                "terminal.ansi.red": "{{colors.red.default.hex}}",
                "terminal.ansi.green": "{{colors.green.default.hex}}",
                "terminal.ansi.yellow": "{{colors.yellow.default.hex}}",
                "terminal.ansi.blue": "{{colors.blue.default.hex}}",
                "terminal.ansi.magenta": "{{colors.magenta.default.hex}}",
                "terminal.ansi.cyan": "{{colors.cyan.default.hex}}",
                "terminal.ansi.white": "{{colors.on_surface.default.hex}}",
                "error": "{{colors.red.default.hex}}",
                "warning": "{{colors.yellow.default.hex}}",
                "success": "{{colors.green.default.hex}}",
                "info": "{{colors.blue.default.hex}}",
                "created": "{{colors.green.default.hex}}",
                "modified": "{{colors.yellow.default.hex}}",
                "deleted": "{{colors.red.default.hex}}",
                "players": [
                    {
                        "cursor": "{{colors.primary.default.hex}}",
                        "selection": "{{colors.primary.default.hex_alpha | set_alpha: 0.25}}",
                        "background": "{{colors.primary.default.hex}}"
                    }
                ],
                "syntax": {
                    "comment": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
                    "keyword": { "color": "{{colors.primary.default.hex}}" },
                    "string": { "color": "{{colors.green.default.hex}}" },
                    "number": { "color": "{{colors.tertiary.default.hex}}" },
                    "boolean": { "color": "{{colors.tertiary.default.hex}}" },
                    "constant": { "color": "{{colors.tertiary.default.hex}}" },
                    "function": { "color": "{{colors.blue.default.hex}}" },
                    "type": { "color": "{{colors.yellow.default.hex}}" },
                    "constructor": { "color": "{{colors.yellow.default.hex}}" },
                    "property": { "color": "{{colors.cyan.default.hex}}" },
                    "variable": { "color": "{{colors.on_surface.default.hex}}" },
                    "variable.special": { "color": "{{colors.magenta.default.hex}}" },
                    "tag": { "color": "{{colors.primary.default.hex}}" },
                    "attribute": { "color": "{{colors.yellow.default.hex}}" },
                    "operator": { "color": "{{colors.on_surface_variant.default.hex}}" },
                    "punctuation": { "color": "{{colors.outline.default.hex}}" },
                    "punctuation.bracket": { "color": "{{colors.on_surface_variant.default.hex}}" },
                    "title": { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
                    "link_uri": { "color": "{{colors.blue.default.hex}}" },
                    "emphasis": { "color": "{{colors.on_surface.default.hex}}", "font_style": "italic" },
                    "emphasis.strong": { "color": "{{colors.on_surface.default.hex}}", "font_weight": 700 }
                }
            }
        }
    ]
}
